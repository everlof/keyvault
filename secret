#!/usr/bin/env bash
#
# secret — everyday tokens in the macOS login keychain, handed to one command at a time.
#
#   secret set SENTRY_AUTH_TOKEN --desc "Sentry CLI, org my-org"     # typed, not echoed
#   secret run SENTRY_AUTH_TOKEN -- sentry-cli releases list          # env for that command only
#   secret run TOKEN=GEMINI_API_KEY -- ./script.sh                    # under another variable name
#   secret list                                                       # names and descriptions only
#
# This is for tokens you can re-issue in a minute: API keys, deploy tokens. Keys that
# cannot be re-issued belong in keyvault. The point is to keep tokens out of shell
# profiles, where every process inherits them, and out of files an agent reads in passing.
#
# Three kinds of item:
#   default   readable by the `security` tool without a prompt. Agents can use it freely,
#             but only on purpose, one command at a time.
#   --ask     trusts no application. Every read raises the macOS keychain dialog, and
#             "Allow" (not "Always Allow") is a one-time approval by you.
#   --plain   not a secret at all (a username, an account id), kept beside the secrets it
#             goes with so `run` can hand them out together. `list` shows its value.
#
# Values never touch argv: they go to `security -i` on stdin, hex-encoded, so they are
# not visible in `ps` and quoting cannot mangle them. `security -i` exits 0 even when the
# command inside it fails, so every write is checked afterwards by looking the item up
# (attributes only — that never decrypts, so it never raises a dialog).
#
set -uo pipefail

readonly SVC="secret-run"
readonly PEND="secret-run.pending"                 # a replacement, parked until it is safe
readonly KC="${SECRET_KEYCHAIN:-}"                 # empty: the default (login) keychain
readonly LOG="${SECRET_STATE:-$HOME/.local/state/secret}/audit.log"

die()  { printf 'secret: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }
kc()   { [[ -n $KC ]] && printf '%s' "$KC"; }      # trailing keychain argument, if any
log()  { mkdir -p "$(dirname "$LOG")"; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG"; }

valid_name() { [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "'$1' is not a valid name (letters, digits, _)"; }

read_value() {   # read_value <name> <stdin?>  -> value on stdout
    local v1 v2
    if [[ $2 == 1 ]]; then
        v1="$(cat)"
    else
        { exec 3</dev/tty; } 2>/dev/null || die "no terminal to type into — use --stdin"
        printf 'Value for %s (not echoed): ' "$1" >/dev/tty; IFS= read -rs v1 <&3; printf '\n' >/dev/tty
        printf 'Again: ' >/dev/tty;                          IFS= read -rs v2 <&3; printf '\n' >/dev/tty
        [[ $v1 == "$v2" ]] || die "the two entries differ"
    fi
    [[ -n $v1 ]] || die "empty value"
    printf '%s' "$v1"
}

# `security -i` tokenizes its own input; quote the free-text fields for it.
iquote() { printf '"%s"' "$(printf '%s' "$1" | tr -d '"\\')"; }

kc_has() { security find-generic-password -s "$1" -a "$2" $(kc) >/dev/null 2>&1; }
kc_del() { security delete-generic-password -s "$1" -a "$2" $(kc) >/dev/null 2>&1; }
kc_add() {   # kc_add <service> <name> <kind> <desc> <ask> <hex> [plain]  — then verify it landed
    local acl="" shown=""; [[ $5 == 1 ]] && acl='-T ""'
    # A plain value is also kept as the generic attribute, which listing reads without decrypting.
    [[ -n ${7:-} ]] && shown="-G $(iquote "$7")"
    printf 'add-generic-password -s %s -a %s -l %s -D %s -j %s %s %s -X %s %s\n' \
        "$1" "$2" "$(iquote "secret $2")" "$(iquote "$3")" "$(iquote "$4")" "$shown" "$acl" "$6" "$(kc)" \
        | security -i >/dev/null 2>&1
    kc_has "$1" "$2"
}

cmd_set() {
    (($#)) || die "usage: secret set NAME [--desc TEXT] [--ask | --plain VALUE] [--stdin]"
    local name="$1"; shift; valid_name "$name"
    local desc="" ask=0 stdin=0 plain=0 pv=""
    while (($#)); do
        case "$1" in
            --desc)  desc="$2"; shift 2 ;;
            --ask)   ask=1; shift ;;
            --plain) plain=1; pv="${2:-}"; shift 2 || die "--plain wants the value: it is not a secret" ;;
            --stdin) stdin=1; shift ;;
            *) die "set: unknown option '$1'" ;;
        esac
    done
    (( ask && plain )) && die "--ask and --plain contradict each other"
    local hex
    if (( plain )); then
        [[ -n $pv ]] || die "empty value"
        hex="$(printf '%s' "$pv" | od -An -tx1 | tr -d ' \n')"
    else
        hex="$(read_value "$name" "$stdin" | od -An -tx1 | tr -d ' \n')" || exit 1
    fi
    [[ -n $hex ]] || exit 1

    local kind="secret"; (( ask )) && kind="secret (ask)"; (( plain )) && kind="plain"

    if ! kc_has "$SVC" "$name"; then
        kc_add "$SVC" "$name" "$kind" "$desc" "$ask" "$hex" "$pv" || die "could not write $name to the keychain"
        kc_del "$PEND" "$name"      # a copy parked by an earlier, interrupted replacement
    else
        # Replacing. -U would keep the old ACL (so --ask could never be added or removed),
        # and delete-then-add loses the old value if the add fails. Instead: park the new
        # value, verify it, and only then retire the old one.
        kc_del "$PEND" "$name"
        kc_add "$PEND" "$name" "$kind" "$desc" "$ask" "$hex" "$pv" \
            || { kc_del "$PEND" "$name"; die "could not write the new value — $name is unchanged"; }
        kc_del "$SVC" "$name"
        if kc_has "$SVC" "$name"; then
            kc_del "$PEND" "$name"; die "could not remove the old $name — it is unchanged"
        fi
        kc_add "$SVC" "$name" "$kind" "$desc" "$ask" "$hex" "$pv" \
            || die "the new value could not be moved into place; it is kept as service '$PEND', account '$name'"
        kc_del "$PEND" "$name"
    fi
    log "set $name$( ((ask)) && echo ' ask')$( ((plain)) && echo ' plain')"
    info "stored $name$( ((ask)) && echo ' (every read asks you)')$( ((plain)) && echo ' (plain: not a secret)')"
}

# Items as "NAME<TAB>kind<TAB>description<TAB>changed<TAB>shown". dump-keychain without -d
# reads attributes only — it never prompts and never decrypts. `changed` is the item's
# mdat, which every set renews: keyvault uses it to tell whether a backup is still current.
# `shown` is a plain item's value, kept as its generic attribute.
items() {
    security dump-keychain $(kc) 2>/dev/null | awk -v svc="$SVC" '
        function flush() { if (s == svc && a != "") printf "%s\t%s\t%s\t%s\t%s\n", a, k, c, m, g; s = a = k = c = m = g = "" }
        /^keychain: / { flush() }
        /"svce"<blob>=/ { s = $0; sub(/.*<blob>="/, "", s); sub(/"$/, "", s) }
        /"acct"<blob>=/ { a = $0; sub(/.*<blob>="/, "", a); sub(/"$/, "", a) }
        /"desc"<blob>=/ { k = $0; sub(/.*<blob>="/, "", k); sub(/"$/, "", k) }
        /"icmt"<blob>=/ { c = $0; sub(/.*<blob>="/, "", c); sub(/"$/, "", c) }
        /"mdat"<timedate>=/ { m = $0; sub(/.*<timedate>=0x[0-9A-Fa-f]* *"/, "", m); sub(/\\000"$/, "", m) }
        /"gena"<blob>="/ { g = $0; sub(/.*<blob>="/, "", g); sub(/"$/, "", g) }
        END { flush() }' | sort
}

cmd_list() {
    local rows; rows="$(items)"
    if [[ ${1:-} == --json ]]; then
        printf '%s\n' "$rows" | jq -R -s 'split("\n") | map(select(length > 0) | split("\t")
            | {name: .[0], ask: (.[1] == "secret (ask)"), plain: (.[1] == "plain"), desc: .[2], changed: .[3]}
            + (if .[1] == "plain" then {value: .[4]} else {} end))'
        return 0
    fi
    [[ -n $rows ]] || { info "no secrets stored (secret set NAME)"; return 0; }
    printf '%-32s %-5s %s\n' NAME ASK DESCRIPTION
    printf '%s\n' "$rows" | awk -F'\t' '{ printf "%-32s %-5s %s\n", $1, ($2 == "secret (ask)" ? "yes" : ($2 == "plain" ? "plain" : "-")), ($2 == "plain" ? $5 "  " $3 : $3) }'
}

fetch() {   # fetch <name> -> value
    local v
    v="$(security find-generic-password -s "$SVC" -a "$1" -w $(kc) 2>/dev/null)" \
        || die "could not read $1 — not stored (secret list), or access was denied"
    printf '%s' "$v"
}

cmd_run() {
    local specs=()
    while (($#)) && [[ $1 != -- ]]; do specs+=("$1"); shift; done
    [[ ${1:-} == -- ]] || die "usage: secret run NAME [VAR=NAME …] -- <command…>"
    shift
    (($#)) || die "run: no command given"
    (( ${#specs[@]} )) || die "run: name at least one secret"
    local spec var name v names=""
    for spec in "${specs[@]}"; do
        if [[ $spec == *=* ]]; then var="${spec%%=*}"; name="${spec#*=}"; else var="$spec"; name="$spec"; fi
        valid_name "$var"; valid_name "$name"
        v="$(fetch "$name")" || exit 1       # not inside export: its status would hide a failure
        export "$var=$v"
        names="$names${names:+,}$name"
    done
    log "run $names cmd=$(basename "$1")"
    exec "$@"
}

cmd_get() {
    (($#)) || die "usage: secret get NAME"
    valid_name "$1"
    [[ -t 1 ]] && info "! printing a secret to your terminal"
    fetch "$1"; [[ -t 1 ]] && printf '\n'
    log "get $1"
}

cmd_rm() {
    (($#)) || die "usage: secret rm NAME"
    valid_name "$1"
    security delete-generic-password -s "$SVC" -a "$1" $(kc) >/dev/null 2>&1 || die "no secret $1"
    log "rm $1"
    info "removed $1"
}

cmd_help() {
    cat <<'EOF'
secret — everyday tokens in the macOS keychain, one command at a time

  set NAME [--desc TEXT] [--ask] [--stdin]   store (typed at the prompt, or piped with --stdin)
                                             --ask: every read raises the keychain dialog
  set NAME --plain VALUE [--desc TEXT]       not a secret (a username, an id): list shows it
  run NAME [VAR=NAME …] -- <command…>        run with those secrets in the environment
  list [--json]                              names and descriptions; never values
  get NAME                                   print one value (for pasting; avoid in scripts)
  rm NAME                                    delete

  SECRET_KEYCHAIN   use this keychain instead of the login keychain
EOF
}

case "${1:-help}" in
    set)          shift; cmd_set "$@" ;;
    run)          shift; cmd_run "$@" ;;
    list|ls)      shift; cmd_list "$@" ;;
    get)          shift; cmd_get "$@" ;;
    rm|remove)    shift; cmd_rm "$@" ;;
    help|-h|--help) cmd_help ;;
    *)            die "unknown command '$1' — try 'secret help'" ;;
esac
