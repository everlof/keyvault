        rm -rf "$mount"
    fi
}

# One workspace per command, gone when the command exits — however it exits.
WS="" WS_DEV=""
ws_open() {
    [[ -n $WS ]] && return 0
    local w; w="$(workspace_create)" || exit 1
    WS="${w%%$'\t'*}"; WS_DEV="${w##*$'\t'}"
    mkdir -p "$WS/keys" "$WS/tmp" "$WS/vault/items"
    chmod 700 "$WS/keys"
    jq -n --argjson v "$KV_MANIFEST_VERSION" '{version:$v, items:[]}' > "$WS/vault/manifest.json"
    trap ws_close EXIT
}
ws_close() {
    trap - EXIT
    [[ -n $WS ]] && workspace_destroy "$WS" "$WS_DEV"
    WS="" WS_DEV=""
}

# ---------------------------------------------------------------------------- the store
#
# <dest>/keyvault/
#     biometric.age  passphrase.age  both.age     what keyvault.conf declares, by level
#     keychain/<id>.<level>.age                    each `identities` line, on its own
#     added/<id>.<level>.age                       each item added by hand, on its own
#
# Declared items are rebuilt by every pack, except keychain identities while the keychain
# still holds exactly the same ones; added items are only touched by add/remove. None
# needs to read another, so no write ever needs a factor.

store_files() {   # "<level>\t<path>\t<adhoc>" per file
    local l f b
    for l in $KV_LEVELS; do
        [[ -f $KV_STORE/$l.age ]] && printf '%s\t%s\tfalse\n' "$l" "$KV_STORE/$l.age"
    done
    for f in "$KV_KEYCHAIN"/*.age; do
        [[ -f $f ]] || continue
        b="$(basename "$f" .age)"
        printf '%s\t%s\tfalse\n' "${b##*.}" "$f"
    done
    for f in "$KV_ADDED"/*.age; do
        [[ -f $f ]] || continue
        b="$(basename "$f" .age)"
        printf '%s\t%s\ttrue\n' "${b##*.}" "$f"
    done
    return 0
}
store_exists() { [[ -n $(store_files) ]]; }
added_file()   { local f; for f in "$KV_ADDED/$1".*.age; do [[ -f $f ]] && { printf '%s\n' "$f"; return 0; }; done; return 1; }
keychain_file() { local l; for l in $KV_LEVELS; do [[ -f $KV_KEYCHAIN/$1.$l.age ]] && { printf '%s\n' "$KV_KEYCHAIN/$1.$l.age"; return 0; }; done; return 1; }

# Copy the whole store aside before any change: a bad pack or add is recoverable, and
# only the last KV_ARCHIVE_KEEP snapshots are kept.
store_archive() {
    store_exists || return 0
    local dst="$KV_ARCHIVE/$(stamp)" n=1
    while [[ -e $dst ]]; do dst="$KV_ARCHIVE/$(stamp)-$((++n))"; done
    mkdir -p "$dst" && cp -Rp "$KV_STORE/." "$dst/" || die "could not archive the current vault"
    local old
    old="$(ls -1dt "$KV_ARCHIVE"/[0-9]*/ 2>/dev/null | tail -n +$((KV_ARCHIVE_KEEP + 1)))"
    [[ -n $old ]] && printf '%s\n' "$old" | while IFS= read -r d; do rm -rf "$d"; done
    return 0
}

# vault_load [id…] — decrypt what holds these ids (everything when none), merged into
# one view at $WS/vault. Asks only for the factors those files need.
vault_load() {
    ws_open
    store_exists || die "no vault at $(tildify "$KV_STORE") — run 'keyvault pack' first"
    local rows want=("$@") row l f a id
    if (( ${#want[@]} )); then
        rows=""
        for id in "${want[@]}"; do
            if f="$(added_file "$id")"; then
                l="$(basename "$f" .age)"; l="${l##*.}"
                row="$l"$'\t'"$f"$'\t'true
            elif f="$(keychain_file "$id")"; then
                l="$(basename "$f" .age)"; l="${l##*.}"
                row="$l"$'\t'"$f"$'\t'false
            else
                # Declared items: the catalog says which level file holds them. A wrong
                # catalog only costs a "not in the vault" below — never access.
                l="$(jq -r --arg id "$id" '.items[]? | select(.id == $id) | .level // empty' "$KV_CATALOG" 2>/dev/null)"
                level_ok "$l" && [[ -f $KV_STORE/$l.age ]] || die "'$id' is not in the vault (keyvault list)"
                row="$l"$'\t'"$KV_STORE/$l.age"$'\t'false
            fi
            grep -qxF "$row" <<<"$rows" || rows="${rows:+$rows$'\n'}$row"
        done
    else
        rows="$(store_files)"
    fi

    local n=0 u
    while IFS=$'\t' read -r l f a; do
        [[ -n $f ]] || continue
        u="$WS/tmp/unsealed.$((++n))"
        unseal "$f" "$l" "$u"
        [[ -f $u/vault/manifest.json ]] || die "$(tildify "$f") holds no manifest — not a keyvault file"
        for id in $(jq -r '.items[].id' "$u/vault/manifest.json"); do
            mf_has "$id" && die "'$id' is in the vault twice — $(tildify "$f") and another file"
        done
        jq --slurpfile add "$u/vault/manifest.json" --arg l "$l" --argjson a "$a" '
            .items += [$add[0].items[] | .level = (.level // $l) | .adhoc = $a]
            | .packed_at = (.packed_at // $add[0].packed_at)' \
            "$WS/vault/manifest.json" > "$WS/vault/manifest.json.new" \
            && mv -f "$WS/vault/manifest.json.new" "$WS/vault/manifest.json"
        [[ -d $u/vault/items ]] && for d in "$u/vault/items"/*; do [[ -e $d ]] && mv "$d" "$WS/vault/items/"; done
        rm -rf "$u"
    done <<<"$rows"
    return 0
}

# Kept under their old names: everything that reads items does so through these.
session_dir()      { printf '%s/vault\n' "$WS"; }
session_manifest() { printf '%s/vault/manifest.json\n' "$WS"; }

# ---------------------------------------------------------------------------- manifest

mf_read()  { cat "$(session_manifest)"; }
mf_write() {   # jq program + args applied to the manifest, written back atomically
    local m; m="$(session_manifest)"
    jq "$@" "$m" > "$m.new" && mv -f "$m.new" "$m" || die "could not update the manifest"
}
mf_item()  { jq -c --arg id "$1" '.items[] | select(.id == $id)' "$(session_manifest)"; }
mf_has()   { [[ -n $(mf_item "$1") ]]; }

KV_CUR_LEVEL=""   # the level of the spec being collected; stamped onto what it produces
mf_put() {   # mf_put <json-object>   — replace by id, else append
    mf_write --argjson it "$1" --arg lv "$KV_CUR_LEVEL" \
        '.items = ((.items | map(select(.id != $it.id)))
                   + [$it + (if ($it.level // "") == "" and $lv != "" then {level: $lv} else {} end)])'
}

mf_drop() { mf_write --arg id "$1" '.items |= map(select(.id != $id))'; }

item_path() { printf '%s/%s\n' "$(session_dir)" "$1"; }
item_swap() {   # item_swap <id> <staged-dir> — replace items/<id> with a finished copy
    local dir; dir="$(item_path "items/$1")"
    rm -rf "$dir" && mv "$2" "$dir" || die "could not replace item $1"
}

# ---------------------------------------------------------------------------- the conf DSL
#
# keyvault.conf is sourced, so it is plain bash and quoting just works. Each directive
# appends one source spec; nothing is collected until pack runs.

declare -a KV_SOURCES=()

_spec() { KV_SOURCES+=("$1"); }

sparkle() {
    local account="$1"; shift
    local plist="" desc="" lv="$KV_LEVEL_DEFAULT"
    while (($#)); do
        case "$1" in
            --plist) plist="$2"; shift 2 ;;
            --desc)  desc="$2";  shift 2 ;;
            --level) lv="$(conf_level "$2")"; shift 2 ;;
            *) die "keyvault.conf: sparkle: unknown option '$1'" ;;
        esac
    done
    _spec "$(jq -nc --arg a "$account" --arg p "$plist" --arg d "$desc" --arg l "$lv" \
        '{type:"sparkle", account:$a, plist:$p, desc:$d, level:$l}')"
}

identities() {
    local keychain="${1:-login.keychain-db}"; shift || true
    local desc="" lv="$KV_LEVEL_DEFAULT"
    while (($#)); do
        case "$1" in
            --desc)  desc="$2"; shift 2 ;;
            --level) lv="$(conf_level "$2")"; shift 2 ;;
            *) die "keyvault.conf: identities: unknown option '$1'" ;;
        esac
    done
    _spec "$(jq -nc --arg k "$keychain" --arg d "$desc" --arg l "$lv" \
        '{type:"identities", keychain:$k, desc:$d, level:$l}')"
}

file() {
    local path="$1"; shift
    local desc="" id="" lv="$KV_LEVEL_DEFAULT"
    while (($#)); do
        case "$1" in
            --desc)  desc="$2"; shift 2 ;;
            --id)    id="$2";   shift 2 ;;
            --level) lv="$(conf_level "$2")"; shift 2 ;;
            *) die "keyvault.conf: file: unknown option '$1'" ;;
        esac
    done
    _spec "$(jq -nc --arg p "$path" --arg d "$desc" --arg i "$id" --arg l "$lv" \
        '{type:"file", path:$p, desc:$d, id:$i, level:$l}')"
}

glob() {
    local dir="$1" pattern="$2"; shift 2
    local desc="" lv="$KV_LEVEL_DEFAULT"
    while (($#)); do
        case "$1" in
            --desc)  desc="$2"; shift 2 ;;
            --level) lv="$(conf_level "$2")"; shift 2 ;;
            *) die "keyvault.conf: glob: unknown option '$1'" ;;
        esac
    done
    _spec "$(jq -nc --arg dir "$dir" --arg pat "$pattern" --arg d "$desc" --arg l "$lv" \
        '{type:"glob", dir:$dir, pattern:$pat, desc:$d, level:$l}')"
}

# meta <id> key=value …  — facts an agent needs to *use* a key without ever seeing it:
# the App Store Connect issuer id, which apps it serves, the team. Merged into the
# manifest at pack time and published, secret-free, in catalog.json.
declare -a KV_META=()

dest() { :; }   # read by conf_dest at startup; nothing to do when the config loads for real

conf_level() { level_ok "$1" || die "keyvault.conf: level must be one of: $KV_LEVELS (got '$1')"; printf '%s\n' "$1"; }
# level <biometric|passphrase|both> — the level for every directive after it, until the next.
level() { KV_LEVEL_DEFAULT="$(conf_level "$1")"; }

meta() {
    local id="$1"; shift
    local kv obj='{}'
    for kv in "$@"; do
        [[ $kv == *=* ]] || die "keyvault.conf: meta $id: expected key=value, got '$kv'"
        obj="$(jq -c --arg k "${kv%%=*}" --arg v "${kv#*=}" '. + {($k): $v}' <<<"$obj")"
    done
    KV_META+=("$(jq -nc --arg id "$id" --argjson m "$obj" '{id:$id, meta:$m}')")
}

# conf_load [soft] — `soft` reports a bad or empty config instead of exiting, so that
# validate can still finish its report on a machine whose config has drifted.
conf_load() {
    local soft="${1:-}"
    KV_SOURCES=(); KV_META=(); KV_LEVEL_DEFAULT="biometric"
    if [[ ! -f $KV_CONF ]]; then
        [[ $soft == soft ]] && return 1
        die "no config at $KV_CONF"
    fi
    # shellcheck disable=SC1090
    if ! source "$KV_CONF"; then
        [[ $soft == soft ]] && return 1
        die "keyvault.conf failed to load"
    fi
    if (( ${#KV_SOURCES[@]} == 0 )); then
        [[ $soft == soft ]] && return 1
        die "keyvault.conf declares nothing to collect"
    fi
    return 0
}

# ---------------------------------------------------------------------------- metadata
#
# What a key *is*, derived from the file itself: kind, key ids, certificate subject and
# expiry, public-key fingerprints. Everything here is public by construction — this is
# what lets an agent find "the ASC key for team X" without being able to read it.

pubkey_sha256() {   # base64 SHA-256 of the DER public key — the form GitHub and Apple show
    # An empty -passin: openssl otherwise asks for a protected key's password on the
    # terminal, in the middle of a pack. Such a key simply gets no fingerprint.
    openssl pkey -in "$1" -passin pass: -pubout -outform DER 2>/dev/null | openssl dgst -sha256 -binary | base64
}

file_meta() {   # file_meta <path>  -> {"kind":…, "meta":{…}}
    local f="$1" name kind=file m='{}' v
    name="$(basename "$f")"
    add_m() { m="$(jq -c --arg k "$1" --arg v "$2" '. + {($k): $v}' <<<"$m")"; }

    if [[ $name =~ AuthKey_([A-Z0-9]{10})\.p8$ ]]; then
        kind=asc-api-key; add_m asc_key_id "${BASH_REMATCH[1]}"
    fi
    case "$name" in *.p12|*.pfx) kind=pkcs12 ;; esac

    if grep -q 'AGE-SECRET-KEY-' "$f" 2>/dev/null; then
        kind=age-identity
        v="$(age-keygen -y "$f" 2>/dev/null | paste -sd, -)"
        [[ -n $v ]] && add_m age_recipient "$v"
    elif grep -q -- '-----BEGIN CERTIFICATE-----' "$f" 2>/dev/null; then
        grep -q -- 'PRIVATE KEY-----' "$f" && kind=certificate-and-key || kind=x509-certificate   # gitleaks:allow — a kind name, not a key
        v="$(openssl x509 -in "$f" -noout -subject -nameopt RFC2253 2>/dev/null | sed 's/^subject=//')"
        [[ -n $v ]] && add_m subject "$v"
        v="$(openssl x509 -in "$f" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
        [[ -n $v ]] && add_m not_after "$v"
    elif grep -q -- 'PRIVATE KEY-----' "$f" 2>/dev/null; then
        [[ $kind == asc-api-key ]] || kind=private-key
    fi
    if grep -q -e 'ENCRYPTED PRIVATE KEY-----' -e '^Proc-Type: 4,ENCRYPTED' "$f" 2>/dev/null; then
        add_m encrypted true
    elif grep -q -- 'PRIVATE KEY-----' "$f" 2>/dev/null; then
        v="$(pubkey_sha256 "$f")"
        [[ -n $v && $v != "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=" ]] && add_m public_key_sha256 "$v"
    fi
    unset -f add_m
    jq -nc --arg k "$kind" --argjson m "$m" '{kind:$k, meta:$m}'
}

cert_not_after() {   # cert_not_after <keychain> <sha1>
    security find-certificate -a -Z -p "$1" 2>/dev/null \
        | awk -v want="$2" '/^SHA-1 hash:/ {h=$3} /BEGIN CERTIFICATE/ {if (h==want) p=1} p {print} /END CERTIFICATE/ {if (p) exit}' \
        | openssl x509 -noout -enddate 2>/dev/null | sed 's/^notAfter=//'
}

# ---------------------------------------------------------------------------- collectors

collect_sparkle() {
    local spec="$1"
    local account plist desc id dir out pub derived
    account="$(jq -r '.account' <<<"$spec")"
    plist="$(untildify "$(jq -r '.plist' <<<"$spec")")"
    desc="$(jq -r '.desc' <<<"$spec")"
    id="sparkle-$account"

    local sb; sb="$(kv_sparkle_bin)" || { bad "$id  Sparkle's tools were not found — build an app that uses Sparkle, or set KEYVAULT_SPARKLE_BIN"; return 1; }

    pub="$("$sb/generate_keys" -p --account "$account" 2>/dev/null)"
    [[ -n $pub ]] || { bad "$id  no key for account '$account' in the login keychain"; return 1; }

    dir="$(item_path "items/$id")"; mkdir -p "$dir"
    out="$dir/private-key.txt"
    rm -f "$out"
    if ! "$sb/generate_keys" -x "$out" --account "$account" >/dev/null 2>&1 || [[ ! -s $out ]]; then
        bad "$id  export failed (did you deny the keychain prompt?)"
        return 1
    fi
    chmod 600 "$out"

    derived="$(ed25519_public_from_seed_file "$out")"
    if [[ -n $derived && $derived != "$pub" ]]; then
        bad "$id  the exported key derives to $derived but the keychain reports $pub"
        return 1
    fi

    mf_put "$(jq -nc \
        --arg id "$id" --arg account "$account" --arg pub "$pub" --arg desc "$desc" \
        --arg plist "$(tildify "$plist")" \
        --arg file "items/$id/private-key.txt" --arg sha "$(sha256_of "$out")" \
        '{id:$id, type:"sparkle", kind:"sparkle-ed25519", account:$account, public_key:$pub,
          plist:$plist, file:$file, sha256:$sha, desc:$desc, adhoc:false}')"
    ok "$id  $pub"
}

# Exporting identities costs one macOS prompt per private key, every time: "Always Allow"
# does not stick for exports. So each `identities` line is sealed on its own, and while the
# keychain holds exactly the identities that sealed copy was made from, pack keeps it
# instead of exporting again. `pack --refresh` exports anyway.
identities_id() { local k; k="$(basename "$(jq -r '.keychain' <<<"$1")")"; printf 'identities-%s\n' "${k%%.*}"; }

identities_unchanged() {   # identities_unchanged <spec> — true when the sealed copy is current
    local keychain id lv desc entry had live m
    keychain="$(jq -r '.keychain' <<<"$1")"; lv="$(jq -r '.level' <<<"$1")"; desc="$(jq -r '.desc' <<<"$1")"
    id="$(identities_id "$1")"
    [[ -f $KV_KEYCHAIN/$id.$lv.age ]] || return 1
    for m in ${KV_META[@]+"${KV_META[@]}"}; do
        [[ $(jq -r '.id' <<<"$m") == "$id" ]] && return 1    # meta lives inside the sealed copy too
    done
    entry="$(jq -c --arg id "$id" '.items[]? | select(.id == $id and .type == "identities")' "$KV_CATALOG" 2>/dev/null)"
    [[ -n $entry && $(jq -r '.level' <<<"$entry") == "$lv" && $(jq -r '.desc // ""' <<<"$entry") == "$desc" ]] || return 1
    had="$(jq -r '.certs[]?.sha1' <<<"$entry" | sort -u)"
    live="$(security find-identity -v "$keychain" 2>/dev/null \
        | sed -n 's/^[[:space:]]*[0-9]*)[[:space:]]*\([0-9A-F]\{40\}\).*/\1/p' | sort -u)"
    [[ -n $live && $live == "$had" ]] || return 1
    ok "$id  unchanged, $(grep -c . <<<"$live") certificates — kept without exporting"
}

# export_identities <keychain-path> <out.p12> <password> <sha1>… — exactly these identities.
# `security export` cannot choose: it takes every identity in the keychain, expired and
# revoked ones too, at one macOS prompt per private key — and one that will not export
# fails them all. The Security framework can choose; python3's ctypes reaches it.
export_identities() {
    python3 - "$@" <<'PY'
import ctypes as C, hashlib, os, sys
S = C.cdll.LoadLibrary("/System/Library/Frameworks/Security.framework/Security")
F = C.cdll.LoadLibrary("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
vp, P = C.c_void_p, C.POINTER
def fn(lib, name, res, *args):
    f = getattr(lib, name); f.restype = res; f.argtypes = list(args); return f
CFStr   = fn(F, "CFStringCreateWithCString", vp, vp, C.c_char_p, C.c_uint32)
CFArr   = fn(F, "CFArrayCreate", vp, vp, P(vp), C.c_long, vp)
CFDict  = fn(F, "CFDictionaryCreate", vp, vp, P(vp), P(vp), C.c_long, vp, vp)
ArrLen  = fn(F, "CFArrayGetCount", C.c_long, vp)
ArrAt   = fn(F, "CFArrayGetValueAtIndex", vp, vp, C.c_long)
DataLen = fn(F, "CFDataGetLength", C.c_long, vp)
DataPtr = fn(F, "CFDataGetBytePtr", vp, vp)
StrOut  = fn(F, "CFStringGetCString", C.c_bool, vp, C.c_char_p, C.c_long, C.c_uint32)
KcOpen  = fn(S, "SecKeychainOpen", C.c_int32, C.c_char_p, P(vp))
Match   = fn(S, "SecItemCopyMatching", C.c_int32, vp, P(vp))
IdCert  = fn(S, "SecIdentityCopyCertificate", C.c_int32, vp, P(vp))
CertDER = fn(S, "SecCertificateCopyData", vp, vp)
Export  = fn(S, "SecItemExport", C.c_int32, vp, C.c_uint32, C.c_uint32, vp, P(vp))
ErrMsg  = fn(S, "SecCopyErrorMessageString", vp, C.c_int32, vp)
const = lambda lib, name: vp.in_dll(lib, name).value
addr  = lambda lib, name: C.addressof(vp.in_dll(lib, name))
UTF8 = 0x08000100
def arr(items):
    a = (vp * len(items))(*items); return CFArr(None, a, len(items), addr(F, "kCFTypeArrayCallBacks"))
def dct(d):
    k = (vp * len(d))(*d.keys()); v = (vp * len(d))(*d.values())
    return CFDict(None, k, v, len(d), addr(F, "kCFTypeDictionaryKeyCallBacks"), addr(F, "kCFTypeDictionaryValueCallBacks"))
def fail(what, st):
    buf = C.create_string_buffer(512); m = ErrMsg(st, None)
    text = buf.value.decode() if m and StrOut(m, buf, 512, UTF8) else ""
    sys.exit("%s: %s (%d)" % (what, text or "error", st))
class Params(C.Structure):   # SecItemImportExportKeyParameters
    _fields_ = [("version", C.c_uint32), ("flags", C.c_uint32), ("passphrase", vp), ("alertTitle", vp),
                ("alertPrompt", vp), ("accessRef", vp), ("keyUsage", vp), ("keyAttributes", vp)]

if os.environ.get("KEYVAULT_KEYCHAIN_NO_UI") == "1":      # tests: fail instead of asking
    fn(S, "SecKeychainSetUserInteractionAllowed", C.c_int32, C.c_bool)(False)
keychain, out, password = sys.argv[1:4]
want = {s.upper() for s in sys.argv[4:]}
kc = vp(); st = KcOpen(keychain.encode(), C.byref(kc))
if st: fail("cannot open " + keychain, st)
q = dct({const(S, "kSecClass"): const(S, "kSecClassIdentity"),
         const(S, "kSecMatchLimit"): const(S, "kSecMatchLimitAll"),
         const(S, "kSecReturnRef"): const(F, "kCFBooleanTrue"),
         const(S, "kSecMatchSearchList"): arr([kc.value])})
res = vp(); st = Match(q, C.byref(res))
if st: fail("cannot list the identities in " + keychain, st)
pick, seen = [], set()
for i in range(ArrLen(res)):
    ident = ArrAt(res, i); cert = vp()
    if IdCert(ident, C.byref(cert)): continue
    der = CertDER(cert); sha = hashlib.sha1(C.string_at(DataPtr(der), DataLen(der))).hexdigest().upper()
    if sha in want and sha not in seen: pick.append(ident); seen.add(sha)
if want - seen: sys.exit("not in %s: %s" % (keychain, " ".join(sorted(want - seen))))
params = Params(0, 0, CFStr(None, password.encode(), UTF8), None, None, None, None, None)
data = vp(); st = Export(arr(pick), 12, 0, C.byref(params), C.byref(data))   # 12: kSecFormatPKCS12
if st: fail("export", st)
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, C.string_at(DataPtr(data), DataLen(data))); os.close(fd)
PY
}

collect_identities() {
    local spec="$1"
    local keychain desc id dir out pw
    keychain="$(jq -r '.keychain' <<<"$spec")"
    desc="$(jq -r '.desc' <<<"$spec")"
    id="$(identities_id "$spec")"

    local listing
    listing="$(security find-identity -v "$keychain" 2>/dev/null)"
    [[ -n $listing ]] || { bad "$id  no identities in $keychain"; return 1; }

    # Stock macOS awk has no 3-argument match(), so parse with sed and let jq do the
    # quoting — certificate common names carry non-ASCII and would break naive escaping.
    local certs
    certs="$(sed -n 's/^[[:space:]]*[0-9]*)[[:space:]]*\([0-9A-F]\{40\}\)[[:space:]]*"\(.*\)"$/\1	\2/p' <<<"$listing")"
    [[ -n $certs ]] || { bad "$id  could not parse 'security find-identity -v $keychain'"; return 1; }

    local certs_json
    certs_json="$(printf '%s\n' "$certs" | jq -R -s -c \
        'split("\n") | map(select(length > 0) | split("\t") | {sha1: .[0], name: .[1]}
          | . + {kind: (.name | split(":")[0]),
                 team_id: (.name | capture("\\((?<t>[A-Z0-9]{10})\\)$").t? // null)})')" \
        || { bad "$id  could not encode the certificate list"; return 1; }

    local sha1 end
    for sha1 in $(jq -r '.[].sha1' <<<"$certs_json"); do
        end="$(cert_not_after "$keychain" "$sha1")"
        [[ -n $end ]] && certs_json="$(jq -c --arg s "$sha1" --arg e "$end" \
            'map(if .sha1 == $s then . + {not_after: $e} else . end)' <<<"$certs_json")"
    done

    dir="$(item_path "items/$id")"; mkdir -p "$dir"
    out="$dir/identities.p12"
    rm -f "$out"
    pw="$(random_password)"

    local kcpath err rc
    [[ $keychain == /* ]] && kcpath="$keychain" || kcpath="$HOME/Library/Keychains/$keychain"
    if have python3 && python3 -c 'import ctypes' 2>/dev/null; then
        info "    macOS asks once for each of these $(jq -r 'length' <<<"$certs_json") private keys (the dialog names Python) — click Allow."
        # shellcheck disable=SC2046
        err="$(export_identities "$kcpath" "$out" "$pw" $(jq -r '.[].sha1' <<<"$certs_json") 2>&1 >/dev/null)"; rc=$?
    else
        info "    macOS asks once for every private key in $keychain, expired ones too — click Allow."
        err="$(security export -k "$keychain" -t identities -f pkcs12 -P "$pw" -o "$out" 2>&1 >/dev/null)"; rc=$?
    fi
    if (( rc )) || [[ ! -s $out ]]; then
        bad "$id  export failed or was denied${err:+: $err}"
        return 1
    fi
    chmod 600 "$out"

    mf_put "$(jq -nc \
        --arg id "$id" --arg keychain "$keychain" --arg pw "$pw" --arg desc "$desc" \
        --arg file "items/$id/identities.p12" --arg sha "$(sha256_of "$out")" \
        --argjson certs "$certs_json" \
        '{id:$id, type:"identities", kind:"codesign-identities", keychain:$keychain, p12_password:$pw, certs:$certs,
          file:$file, sha256:$sha, desc:$desc, adhoc:false}')"
    ok "$id  $(jq -r 'length' <<<"$certs_json") certificates"
}

# The destination folder can legitimately hold keys too (it does here), so a source glob
# may point straight at it. Never collect keyvault's own output: a vault holding a copy of
# itself doubles every pack, and the catalog is regenerated anyway. Compare canonicalized
# on both sides — $KV_DEST may sit under a symlinked parent that resolve_path collapsed.
is_own_output() {   # is_own_output <resolved-path>
    local path="$1" c_archive c_dest c_store
    c_archive="$(cd "$KV_ARCHIVE" 2>/dev/null && pwd -P)"
    c_store="$(cd "$KV_STORE" 2>/dev/null && pwd -P)"
    c_dest="$(cd "$KV_DEST" 2>/dev/null && pwd -P)"
    [[ -n $c_archive && $path == "$c_archive"/* ]] && return 0
    [[ -n $c_store && $path == "$c_store"/* ]] && return 0
    case "$path" in
        "$c_dest/README.txt"|"$c_dest/catalog.json"|"$c_dest/catalog.json.new") [[ -n $c_dest ]] ;;
        *) return 1 ;;
    esac
}

# Every file a glob spec matches right now, resolved — the same set collect_glob packs.
glob_matches() {   # glob_matches <spec>
    local dir pattern f p
    dir="$(untildify "$(jq -r '.dir' <<<"$1")")"; pattern="$(jq -r '.pattern' <<<"$1")"
    [[ -d $dir ]] || return 0
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        p="$(resolve_path "$f")"
        is_own_output "$p" || printf '%s\n' "$p"
    done < <(find -L "$dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort)
}

collect_file() {   # collect_file <path> <desc> [id] [adhoc]
    local given="$1" desc="$2" id="${3:-}" adhoc="${4:-false}"
    [[ -e $given ]] || { bad "${id:-$given}  no such file"; return 1; }

    # Store the real bytes under the real path; remember the link so restore rebuilds both.
    # Only a genuine symlink counts: resolve_path also canonicalizes a symlinked *parent*
    # (/var -> /private/var), and recording that as a link would invent one that never was.
    local path link=""
    path="$(resolve_path "$given")"
    [[ -L $given ]] && link="$given"
    [[ -f $path ]] || { bad "${id:-$given}  is not a regular file (broken symlink?)"; return 1; }

    if is_own_output "$path"; then
        note "skipping $(tildify "$path") — that is keyvault's own output"
        return 0
    fi

    [[ -n $id ]] || id="$(basename "$path" | tr ' ' '_')"

    # Ids come from basenames, and key bundles are full of cert.pem / key.pem. Two
    # different files landing on one id would mean the vault silently holds one of them
    # twice and the other not at all — the worst thing a backup can do quietly.
    local existing other
    existing="$(mf_item "$id")"
    if [[ -n $existing ]]; then
        other="$(jq -r '.path // ""' <<<"$existing")"
        if [[ -n $other && $other != "$(tildify "$path")" ]]; then
            bad "$id  claimed by two files: $(tildify "$other")"
            bad "$(printf '%*s' ${#id} '')  and $(tildify "$path") — give one an --id in keyvault.conf"
            return 1
        fi
    fi

    local dir out
    dir="$(item_path "items/$id")"; mkdir -p "$dir"
    out="$dir/$(basename "$path")"
    cp -p "$path" "$out" || { bad "$id  copy failed"; return 1; }
    chmod 600 "$out"

    mf_put "$(jq -nc \
        --arg id "$id" --arg path "$(tildify "$path")" --arg mode "$(file_mode "$path")" \
        --arg link "$([[ -n $link ]] && tildify "$link")" \
        --arg file "items/$id/$(basename "$path")" --arg sha "$(sha256_of "$path")" \
        --arg desc "$desc" --argjson adhoc "$adhoc" --argjson fm "$(file_meta "$path")" \
        '{id:$id, type:"file", kind:$fm.kind, path:$path, mode:$mode,
          link:(if $link == "" then null else $link end),
          file:$file, sha256:$sha, desc:$desc, meta:$fm.meta, adhoc:$adhoc}')"
    if [[ -n $link ]]; then
        ok "$id  $(tildify "$path")  $(dim "(via $(tildify "$link"))")"
    else
        ok "$id  $(tildify "$path")"
    fi
    if mf_item "$id" | jq -e '.meta.encrypted == "true"' >/dev/null; then
        warn "$id  is password-protected; the vault keeps it as it is, not its password"
    fi
}

collect_glob() {
    local spec="$1" dir pattern desc n=0 rc=0
    dir="$(untildify "$(jq -r '.dir' <<<"$spec")")"
    pattern="$(jq -r '.pattern' <<<"$spec")"
    desc="$(jq -r '.desc' <<<"$spec")"
    [[ -d $dir ]] || { warn "glob $(tildify "$dir")  directory does not exist — skipped"; return 0; }
    local f
    # A file that fails here must fail the pack. Swallowing it would mean a key silently
    # absent from a vault that reported success — which is how a backup lies to you.
    # The loop runs in this shell (not a pipeline subshell) so rc survives.
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        if collect_file "$f" "$desc" "" false; then n=$((n + 1)); else rc=1; fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort)
    (( n )) || warn "glob $(tildify "$dir")/$pattern  matched nothing"
    return $rc
}

# ---------------------------------------------------------------------------- pack
#
# Collect everything keyvault.conf declares onto the RAM disk, then encrypt one file per
# level, and one per `identities` line. Encrypting needs only public keys, so pack never
# asks for Touch ID or the passphrase — only macOS's own Keychain prompts while exporting,
# and those only when the keychain's identities changed. All or nothing: if any source
# fails, nothing on disk changes.

# pack_seal <level> <dest> <packed_at> <id>… — these items, with their slice of the
# manifest, sealed at <level> into <dest>.new.
pack_seal() {
    local l="$1" dest="$2" t="$3" out="$WS/out" id rc; shift 3
    rm -rf "$out"; mkdir -p "$out/vault/items"
    for id in "$@"; do cp -Rp "$(item_path "items/$id")" "$out/vault/items/"; done
    jq --arg l "$l" --arg t "$t" --arg by "$(whoami)@$(hostname -s)" --arg v "$KV_VERSION" \
        --argjson ids "$(jq -nc '$ARGS.positional' --args -- "$@")" \
        '.items |= map(select(.id as $i | any($ids[]; . == $i)))
         | .level = $l | .packed_at = $t | .packed_by = $by | .tool_version = $v' \
        "$(session_manifest)" > "$out/vault/manifest.json"
    tar -czf "$WS/tmp/pack.tgz" -C "$out" vault && rm -rf "$out" \
        && mkdir -p "$(dirname "$dest")" && seal "$l" "$WS/tmp/pack.tgz" "$dest.new"
    rc=$?
    rm -f "$WS/tmp/pack.tgz"
    return $rc
}

cmd_pack() {
    local refresh=0
    while (($#)); do
        case "$1" in
            --refresh) refresh=1; shift ;;     # export keychain identities even if unchanged
            *) die "pack: unknown option '$1'" ;;
        esac
    done
    have jq || die "jq is not installed — run: brew install jq"
    age_require
    keys_require
    conf_load
    ws_open

    step "Collecting"
    local spec type id failed=0 kept=() keep=()    # kept: identities ids not re-exported; keep: their files
    for spec in "${KV_SOURCES[@]}"; do
        type="$(jq -r '.type' <<<"$spec")"
        KV_CUR_LEVEL="$(jq -r '.level // "biometric"' <<<"$spec")"
        case "$type" in
            sparkle)    collect_sparkle "$spec"    || failed=1 ;;
            identities)
                if (( ! refresh )) && identities_unchanged "$spec"; then
                    id="$(identities_id "$spec")"
                    kept+=("$id"); keep+=("$KV_KEYCHAIN/$id.$KV_CUR_LEVEL.age")
                else
                    collect_identities "$spec" || failed=1
                fi ;;
            file)       collect_file "$(untildify "$(jq -r '.path' <<<"$spec")")" \
                                     "$(jq -r '.desc' <<<"$spec")" \
                                     "$(jq -r '.id'   <<<"$spec")" false || failed=1 ;;
            glob)       collect_glob "$spec"      || failed=1 ;;
            *) die "keyvault.conf: unknown source type '$type'" ;;
        esac
    done
    KV_CUR_LEVEL=""

    local m mid
    for m in ${KV_META[@]+"${KV_META[@]}"}; do
        mid="$(jq -r '.id' <<<"$m")"
        if mf_has "$mid"; then
            mf_write --arg id "$mid" --argjson m "$(jq -c '.meta' <<<"$m")" \
                '.items |= map(if .id == $id then .meta = ((.meta // {}) + $m) else . end)'
        elif ! added_file "$mid" >/dev/null; then
            warn "meta $mid  no such item — check the id with 'keyvault list'"
        fi
    done

    # A declared item and a hand-added one may not share an id: restore would not know
    # which one belongs at the path.
    for id in $(jq -r '.items[].id' "$(session_manifest)"); do
        added_file "$id" >/dev/null && { bad "$id  is declared in keyvault.conf and was also added by hand — 'keyvault remove $id' or give it an --id"; failed=1; }
    done

    if (( failed )); then
        info ""
        die "some sources failed — nothing was written. Fix them and run 'keyvault pack' again."
    fi

    step "Sealing"
    local l n ids packed_at; packed_at="$(now_utc)"
    mkdir -p "$KV_STORE"
    rm -f "$KV_STORE"/*.age.new "$KV_KEYCHAIN"/*.age.new
    for l in $KV_LEVELS; do
        ids="$(jq -r --arg l "$l" '.items[] | select(.level == $l and .type != "identities") | .id' "$(session_manifest)")"
        [[ -n $ids ]] || continue
        # shellcheck disable=SC2086
        pack_seal "$l" "$KV_STORE/$l.age" "$packed_at" $ids \
            || { rm -f "$KV_STORE"/*.age.new "$KV_KEYCHAIN"/*.age.new; die "could not seal the $l level — nothing was written"; }
        n="$(grep -c . <<<"$ids")"
        ok "$l  $n item$( ((n > 1)) && echo s)"
    done
    for id in $(jq -r '.items[] | select(.type == "identities") | .id' "$(session_manifest)"); do
        l="$(mf_item "$id" | jq -r '.level')"
        pack_seal "$l" "$KV_KEYCHAIN/$id.$l.age" "$packed_at" "$id" \
            || { rm -f "$KV_STORE"/*.age.new "$KV_KEYCHAIN"/*.age.new; die "could not seal $id — nothing was written"; }
        keep+=("$KV_KEYCHAIN/$id.$l.age")
        ok "$id  $l, in a file of its own"
    done

    # Every file sealed: only now does anything on disk change.
    store_archive
    for l in $KV_LEVELS; do
        if [[ -f $KV_STORE/$l.age.new ]]; then
            mv -f "$KV_STORE/$l.age.new" "$KV_STORE/$l.age" && chmod 600 "$KV_STORE/$l.age"
        else
            rm -f "$KV_STORE/$l.age"     # nothing at this level any more
        fi
    done
    local f
    for f in "$KV_KEYCHAIN"/*.age.new; do
        [[ -f $f ]] && mv -f "$f" "${f%.new}" && chmod 600 "${f%.new}"
    done
    for f in "$KV_KEYCHAIN"/*.age; do        # an identities line that is gone, or changed level
        [[ -f $f ]] || continue
        printf '%s\n' ${keep[@]+"${keep[@]}"} | grep -qxF "$f" || rm -f "$f"
    done

    catalog_write_pack "$(session_manifest)" "$packed_at" ${kept[@]+"${kept[@]}"}
    dest_readme_write
    say ""
    ok "$(tildify "$KV_STORE")"
    note "check it: 'keyvault verify'. Recovery needs only your recovery key: 'keyvault card'."
}

# ---------------------------------------------------------------------------- list

# From the catalog: listing what is in the vault should not cost a Touch ID.
cmd_list() {
    have jq || die "jq is not installed"
    store_exists || die "no vault at $(tildify "$KV_STORE") — run 'keyvault pack' first"
    [[ -f $KV_CATALOG ]] || die "the vault has no catalog.json — run 'keyvault pack' to rebuild it"
    say "${C_BOLD}$(tildify "$KV_STORE")${C_RESET}"
    say "$(dim "packed $(jq -r '.packed_at // "never"' "$KV_CATALOG")")"
    say ""
    printf '%-34s %-11s %-11s %-5s %s\n' "ID" "LEVEL" "TYPE" "ADDED" "DETAIL"
    printf '%s\n' "$(dim "$(printf '%.0s─' {1..90})")"
    jq -r '.items[] | [.id, (.level // "?"), .type, (if .adhoc then "yes" else "-" end),
            (if .type == "sparkle" then .public_key
             elif .type == "identities" then "\(.certs | length) certificates"
             elif .path then .path else (.desc // "") end)] | @tsv' "$KV_CATALOG" \
        | while IFS=$'\t' read -r id l t a d; do
            printf '%-34s %-11s %-11s %-5s %s\n' "$id" "$l" "$t" "$a" "$d"
          done
}

# ---------------------------------------------------------------------------- add / remove
#
# A hand-added item is its own file, added/<id>.<level>.age. Adding one encrypts, and
# removing one deletes (after archiving), so neither ever needs Touch ID or the passphrase.

cmd_add() {
    (($#)) || die "usage: keyvault add <id> --file PATH | --secret | --stdin  [--level L] [--desc TEXT] [--meta k=v] [--restore-to PATH]"
    local id="$1"; shift
    local src="" mode="" desc="" restore_to="" extra='{}' lv=""
    while (($#)); do
        case "$1" in
            --file)       mode=file;   src="$2"; shift 2 ;;
            --secret)     mode=secret; shift ;;
            --stdin)      mode=stdin;  shift ;;
            --desc)       desc="$2";       shift 2 ;;
            --level)      lv="$2";         shift 2 ;;
            --restore-to) restore_to="$2"; shift 2 ;;
            --meta)       [[ $2 == *=* ]] || die "add: --meta wants key=value"
                          extra="$(jq -c --arg k "${2%%=*}" --arg v "${2#*=}" '. + {($k): $v}' <<<"$extra")"
                          shift 2 ;;
            *) die "add: unknown option '$1'" ;;
        esac
    done
    [[ -n $mode ]] || die "add: one of --file PATH, --secret or --stdin is required"
    [[ $id =~ ^[A-Za-z0-9_-][A-Za-z0-9._-]*$ ]] || die "add: id must be [A-Za-z0-9._-]"
    [[ -n $lv ]] || lv="biometric"      # predictable: never depends on where 'level' sits in the config
    level_ok "$lv" || die "add: --level must be one of: $KV_LEVELS"
    have jq || die "jq is not installed"
    age_require
    keys_require
    if jq -e --arg id "$id" 'any(.items[]?; .id == $id and (.adhoc | not))' "$KV_CATALOG" >/dev/null 2>&1; then
        die "add: '$id' is declared in keyvault.conf — choose another id"
    fi

    ws_open
    KV_CUR_LEVEL="$lv"
    local dir; dir="$(item_path "items/$id")"; mkdir -p "$dir"
    case "$mode" in
        file)
            src="$(untildify "$src")"
            [[ -f $src ]] || die "add: no such file: $src"
            [[ -n $restore_to ]] || restore_to="$src"
            cp -p "$src" "$dir/$(basename "$src")" || die "add: copy failed"
            chmod 600 "$dir/$(basename "$src")"
            mf_put "$(jq -nc \
                --arg id "$id" --arg path "$(tildify "$restore_to")" --arg mode "$(file_mode "$src")" \
                --arg file "items/$id/$(basename "$src")" --arg sha "$(sha256_of "$src")" \
                --arg desc "$desc" --argjson fm "$(file_meta "$src")" --argjson x "$extra" \
                '{id:$id, type:"file", kind:$fm.kind, path:$path, mode:$mode, file:$file,
                  sha256:$sha, desc:$desc, meta:($fm.meta + $x), adhoc:true}')"
            ;;
        secret|stdin)
            local out="$dir/secret"
            if [[ $mode == secret ]]; then
                local v1 v2
                { exec 4</dev/tty; } 2>/dev/null || die "add --secret needs a terminal; pipe it in with --stdin"
                printf 'Secret for %s (not echoed): ' "$id" >/dev/tty; IFS= read -rs v1 <&4; printf '\n' >/dev/tty
                printf 'Again: ' >/dev/tty;                            IFS= read -rs v2 <&4; printf '\n' >/dev/tty
                exec 4<&-
                [[ $v1 == "$v2" ]] || die "add: the two entries differ"
                [[ -n $v1 ]] || die "add: empty secret"
                ( umask 077; printf '%s' "$v1" > "$out" )
            else
                ( umask 077; cat > "$out" )
                [[ -s $out ]] || die "add: nothing arrived on stdin"
            fi
            mf_put "$(jq -nc \
                --arg id "$id" --arg file "items/$id/secret" --arg sha "$(sha256_of "$out")" \
                --arg desc "$desc" --arg to "$(tildify "${restore_to:-}")" --argjson x "$extra" \
                '{id:$id, type:"secret", kind:"secret", meta:$x, file:$file, sha256:$sha, desc:$desc,
                  path:(if $to == "" then null else $to end), adhoc:true}')"
            ;;
    esac
    KV_CUR_LEVEL=""

    mf_write --arg t "$(now_utc)" '.added_at = $t'
    tar -czf "$WS/tmp/add.tgz" -C "$(dirname "$(session_dir)")" vault \
        && mkdir -p "$KV_ADDED" \
        && seal "$lv" "$WS/tmp/add.tgz" "$KV_ADDED/$id.$lv.age.new" \
        || { rm -f "$KV_ADDED/$id.$lv.age.new"; die "add: could not seal $id — nothing was written"; }
    store_archive
    local old; old="$(added_file "$id")" && [[ $old != "$KV_ADDED/$id.$lv.age" ]] && rm -f "$old"
    mv -f "$KV_ADDED/$id.$lv.age.new" "$KV_ADDED/$id.$lv.age" && chmod 600 "$KV_ADDED/$id.$lv.age"
    catalog_upsert "$(session_manifest)"
    ok "$id  sealed at level $lv"
}

cmd_remove() {
    (($#)) || die "usage: keyvault remove <id>"
    local id="$1" f
    have jq || die "jq is not installed"
    if ! f="$(added_file "$id")"; then
        jq -e --arg id "$id" 'any(.items[]?; .id == $id)' "$KV_CATALOG" >/dev/null 2>&1 \
            && die "remove: '$id' comes from keyvault.conf — take it out there and run 'keyvault pack'"
        die "remove: no item with id '$id' (keyvault list)"
    fi
    store_archive
    rm -f "$f"
    catalog_drop "$id"
    ok "$id  removed (a copy stays in $(tildify "$KV_ARCHIVE") for $KV_ARCHIVE_KEEP more changes)"
}

# ---------------------------------------------------------------------------- secret
#
# `keyvault secret …` is the `secret` tool with a backup built in. `set` stores the token and
# seals a copy into the vault from the value it already holds: encrypting needs no unlock,
# so the backup costs no prompt, not even for an --ask token. `rm` removes both. `backup`
# catches up on tokens stored with plain `secret`. Everything else passes straight through.

cmd_secret() {
    local sb; sb="$(secret_bin)" || die "the 'secret' tool was not found next to keyvault or on PATH"
    local sub="${1:-help}"; shift || true
    case "$sub" in
        set)       secret_set "$sb" "$@" ;;
        rm|remove) secret_rm "$sb" "$@" ;;
        backup)    secret_backup "$sb" ;;
        *)         exec "$sb" "$sub" "$@" ;;
    esac
}

secret_set() {
    local sb="$1"; shift
    (($#)) || die "usage: keyvault secret set NAME [--desc TEXT] [--ask] [--stdin]"
    local name="$1"; shift
    local desc="" ask=0 stdin=0 v v2 err
    while (($#)); do
        case "$1" in
            --desc)  desc="$2"; shift 2 ;;
            --ask)   ask=1; shift ;;
            --stdin) stdin=1; shift ;;
            *) die "secret set: unknown option '$1'" ;;
        esac
    done
    [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "'$name' is not a valid name (letters, digits, _)"
    # Read once, here: the value goes to both places and is never read back from the keychain.
    if (( stdin )); then
        v="$(cat)"
    else
        { exec 4</dev/tty; } 2>/dev/null || die "no terminal to type into — use --stdin"
        printf 'Value for %s (not echoed): ' "$name" >/dev/tty; IFS= read -rs v <&4; printf '\n' >/dev/tty
        printf 'Again: ' >/dev/tty;                          IFS= read -rs v2 <&4; printf '\n' >/dev/tty
        exec 4<&-
        [[ $v == "$v2" ]] || die "the two entries differ"
    fi
    [[ -n $v ]] || die "empty value"
    # shellcheck disable=SC2046
    printf '%s' "$v" | "$sb" set "$name" --stdin --desc "$desc" $( ((ask)) && echo --ask) || exit 1
    if err="$(printf '%s' "$v" | token_seal "$name" "$ask" "$desc" 2>&1 >/dev/null)"; then
        v=""; ok "$name  backed up in keyvault"
    else
        v=""; warn "$name  is stored, but NOT backed up in keyvault: ${err#keyvault: }"
        note "fix that, then run: keyvault secret backup"
        return 1
    fi
}

secret_rm() {
    local sb="$1"; shift
    (($#)) || die "usage: keyvault secret rm NAME"
    "$sb" rm "$1" || exit 1
    added_file "$(token_id "$1")" >/dev/null || return 0
    "${BASH:-bash}" "$KV_ROOT/keyvault" remove "$(token_id "$1")" >/dev/null 2>&1 \
        && ok "$1  removed from keyvault too (the archive keeps it for $KV_ARCHIVE_KEEP more changes)" \
        || { warn "$1  its copy stays in keyvault: keyvault remove $(token_id "$1")"; return 1; }
}

secret_backup() {   # copy every token whose copy is missing or older than the token
    local sb="$1" copies t name ask err n=0 rc=0
    copies="$(jq -c '[.items[]? | select(.meta.token) | {t: .meta.token, c: (.meta.changed // "")}]' "$KV_CATALOG" 2>/dev/null)"
    [[ -n $copies ]] || copies='[]'
    while IFS= read -r t; do
        name="$(jq -r '.name' <<<"$t")"; ask="$(jq -r '.ask' <<<"$t")"
        jq -e --arg n "$name" --arg c "$(jq -r '.changed // ""' <<<"$t")" 'any(.[]; .t == $n and .c == $c)' \
            <<<"$copies" >/dev/null && continue
        [[ $ask == true ]] && info "  reading $name raises the keychain dialog — click Allow"
        if err="$("$sb" get "$name" 2>/dev/null \
                  | token_seal "$name" "$([[ $ask == true ]] && echo 1 || echo 0)" "$(jq -r '.desc // ""' <<<"$t")" 2>&1 >/dev/null)"; then
            ok "$name  backed up"; n=$((n + 1))
        else
            bad "$name  ${err#keyvault: }"; rc=1
        fi
    done < <(tokens_list | jq -c '.[]')
    (( n || rc )) || ok "every token already has a current copy in keyvault"
    return $rc
}

# ---------------------------------------------------------------------------- show

cmd_show() {
    (($#)) || die "usage: keyvault show <id> [--out PATH | --stdout] [--recovery]"
    local id="$1"; shift
    local out="" to_stdout=0
    while (($#)); do
        case "$1" in
            --out)      out="$2"; shift 2 ;;
            --stdout)   to_stdout=1; shift ;;
            --recovery) KV_RECOVERY=1; shift ;;
            --via)      KV_VIA="$2"; shift 2 ;;
            *) die "show: unknown option '$1'" ;;
        esac
    done
    (( to_stdout )) || [[ -n $out ]] || die "show: pass --out PATH (safe) or --stdout (goes into your scrollback)"
    have jq || die "jq is not installed"
    vault_load "$id"
    local it; it="$(mf_item "$id")"
    [[ -n $it ]] || die "show: no item with id '$id'"
    local src; src="$(session_dir)/$(jq -r '.file' <<<"$it")"

    if (( to_stdout )); then
        [[ -t 1 ]] && info "${C_YELLOW}!${C_RESET} writing a secret to your terminal scrollback."
        cat "$src"
    else
        out="$(untildify "$out")"
        [[ -e $out ]] && die "show: $out already exists"
        ( umask 077 && cp "$src" "$out" ) || die "show: could not write $out"
        ok "$id -> $(tildify "$out")"
    fi
}

# ---------------------------------------------------------------------------- opening options

# --recovery opens with the paper key instead of this machine's factors (the only way on
# a new Mac); --via picks the device that unlocks the biometric factor.
open_opt() {   # open_opt "$1" "$2" -> how many args it consumed (0 if not an open option)
    case "$1" in
        --recovery) KV_RECOVERY=1; return 1 ;;
        --via)      [[ -n ${2:-} ]] || die "--via needs a device name"; KV_VIA="$2"; return 2 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------- verify
#
# Offline: does the vault hold what its manifest says it holds? No keychain, no prompts,
# no network. This is the check you run on a *different* machine to answer "is my backup
# actually good", which is the only question that matters before you need it.

cmd_verify() {
    local n
    while (($#)); do open_opt "$@"; n=$?; (( n )) || die "verify: unknown option '$1'"; shift "$n"; done
    have jq || die "jq is not installed"
    vault_load
    step "Verifying $(tildify "$KV_STORE")$( ((KV_RECOVERY)) && echo ' with the recovery key')"

    local rc=0 it
    while IFS= read -r it; do
        local id type file sha actual
        id="$(jq -r '.id' <<<"$it")"; type="$(jq -r '.type' <<<"$it")"
        file="$(jq -r '.file' <<<"$it")"; sha="$(jq -r '.sha256' <<<"$it")"
        local full="$(session_dir)/$file"

        if [[ ! -f $full ]]; then
            bad "$id  the manifest names $file, which is not in the vault"; rc=1; continue
        fi
        actual="$(sha256_of "$full")"
        if [[ $actual != "$sha" ]]; then
            bad "$id  checksum mismatch (stored $sha, actual $actual)"; rc=1; continue
        fi

        case "$type" in
            sparkle)
                local recorded derived st
                recorded="$(jq -r '.public_key' <<<"$it")"
                derived="$(ed25519_public_from_seed_file "$full")"; st=$?
                if (( st == 2 )); then
                    warn "$id  checksum ok; cannot derive the public key (python3 'cryptography' missing)"
                elif (( st != 0 )) || [[ -z $derived ]]; then
                    bad "$id  the stored private key is not a valid ed25519 key"; rc=1
                elif [[ $derived != "$recorded" ]]; then
                    bad "$id  stored key derives to $derived, manifest claims $recorded"; rc=1
                else
                    ok "$id  private key derives to $recorded"
                fi
                ;;
            identities)
                local pw n
                pw="$(jq -r '.p12_password' <<<"$it")"
                n="$(openssl pkcs12 -in "$full" -nokeys -passin "pass:$pw" -legacy 2>/dev/null \
                        | grep -c 'BEGIN CERTIFICATE')"
                [[ $n == 0 ]] && n="$(openssl pkcs12 -in "$full" -nokeys -passin "pass:$pw" 2>/dev/null \
                        | grep -c 'BEGIN CERTIFICATE')"
                local claimed; claimed="$(jq -r '.certs | length' <<<"$it")"
                if [[ $n == 0 ]]; then
                    warn "$id  checksum ok; openssl could not open the .p12 to count certificates"
                elif [[ $n != "$claimed" ]]; then
                    bad "$id  manifest claims $claimed certificates, the .p12 holds $n"; rc=1
                else
                    ok "$id  .p12 opens with the stored password, $n certificates"
                fi
                ;;
            *)
                ok "$id  checksum ok ($(wc -c <"$full" | tr -d ' ') bytes)"
                ;;
        esac
    done < <(jq -c '.items[]' "$(session_manifest)")

    say ""
    (( rc )) && bad "the vault is NOT sound — see above" || ok "the vault is internally sound"
    return $rc
}

# ---------------------------------------------------------------------------- validate
#
# Does the vault still describe *this machine*? Answers the two questions a backup can
# get wrong: something on the machine changed and the vault is stale, or the vault holds
# a key that no longer signs what it is supposed to sign.

cmd_validate() {
    local n
    while (($#)); do open_opt "$@"; n=$?; (( n )) || die "validate: unknown option '$1'"; shift "$n"; done
    have jq || die "jq is not installed"
    vault_load
    step "Validating against this machine"

    local rc=0 stale=0 it toks; toks="$(tokens_list)"
    while IFS= read -r it; do
        local id type; id="$(jq -r '.id' <<<"$it")"; type="$(jq -r '.type' <<<"$it")"
        local full; full="$(session_dir)/$(jq -r '.file' <<<"$it")"

        case "$type" in
            sparkle)
                local account recorded derived live plist shipped
                account="$(jq -r '.account' <<<"$it")"
                recorded="$(jq -r '.public_key' <<<"$it")"
                plist="$(untildify "$(jq -r '.plist // ""' <<<"$it")")"
                derived="$(ed25519_public_from_seed_file "$full")"

                if [[ -n $derived && $derived != "$recorded" ]]; then
                    bad "$id  the stored key derives to $derived, not the recorded $recorded"; rc=1; continue
                fi

                local sb; sb="$(kv_sparkle_bin)"
                if [[ -n $sb ]]; then
                    live="$("$sb/generate_keys" -p --account "$account" 2>/dev/null)"
                    if [[ -z $live ]]; then
                        warn "$id  no key for '$account' in this keychain — the vault is your only copy"
                    elif [[ $live != "$recorded" ]]; then
                        bad "$id  keychain now holds $live, the vault holds $recorded — run 'keyvault pack'"; rc=1; stale=1; continue
                    else
                        ok "$id  matches the login keychain"
                    fi
                else
                    note "$id  Sparkle's tools not found; skipped the keychain comparison"
                fi

                if [[ -n $plist ]]; then
                    shipped="$(plist_public_key "$plist")"
                    if [[ -z $shipped ]]; then
                        warn "$id  no SUPublicEDKey in $(tildify "$plist")"
                    elif [[ $shipped != "$recorded" ]]; then
                        bad "$id  $(tildify "$plist") ships $shipped"
                        bad "$(printf '%*s' ${#id} '')  but this key is $recorded — installed copies would reject its updates"
                        rc=1
                    else
                        ok "$id  signs updates the shipped Info.plist accepts"
                    fi
                fi
                ;;

            identities)
                local keychain vault_sha1 live_sha1 missing extra
                keychain="$(jq -r '.keychain' <<<"$it")"
                vault_sha1="$(jq -r '.certs[].sha1' <<<"$it" | sort)"
                live_sha1="$(security find-identity -v "$keychain" 2>/dev/null \
                    | sed -n 's/^[[:space:]]*[0-9]*)[[:space:]]*\([0-9A-F]\{40\}\).*/\1/p' | sort)"
                missing="$(comm -23 <(printf '%s\n' "$vault_sha1") <(printf '%s\n' "$live_sha1"))"
                extra="$(comm -13 <(printf '%s\n' "$vault_sha1") <(printf '%s\n' "$live_sha1"))"

                local nv; nv="$(grep -c . <<<"$vault_sha1")"
                if [[ -z $missing && -z $extra ]]; then
                    ok "$id  all $nv certificates still in $keychain"
                else
                    [[ -n $missing ]] && {
                        warn "$id  in the vault but no longer in $keychain (restorable):"
                        local s; while IFS= read -r s; do [[ -n $s ]] || continue
                            note "    $(jq -r --arg s "$s" '.certs[] | select(.sha1==$s) | .name' <<<"$it")"
                        done <<<"$missing"
                    }
                    [[ -n $extra ]] && {
                        warn "$id  in $keychain but NOT in the vault — run 'keyvault pack':"
                        local s; while IFS= read -r s; do [[ -n $s ]] || continue
                            note "    $(security find-identity -v "$keychain" | grep "$s" | sed 's/.*"\(.*\)"/\1/')"
                        done <<<"$extra"
                        stale=1
                    }
                fi
                ;;

            file)
                local path disk
                path="$(untildify "$(jq -r '.path' <<<"$it")")"
                if [[ ! -f $path ]]; then
                    warn "$id  $(tildify "$path") is gone from disk — the vault is your only copy"
                else
                    disk="$(sha256_of "$path")"
                    if [[ $disk == "$(jq -r '.sha256' <<<"$it")" ]]; then
                        ok "$id  identical to $(tildify "$path")"
                    else
                        warn "$id  $(tildify "$path") differs from the vault copy — run 'keyvault pack'"
                        stale=1
                    fi
                fi
                ;;

            secret)
                local token; token="$(jq -r '.meta.token // ""' <<<"$it")"
                if [[ -z $token ]]; then
                    ok "$id  present ($(jq -r '.desc // "no description"' <<<"$it"))"
                elif ! jq -e --arg n "$token" 'any(.[]; .name == $n)' <<<"$toks" >/dev/null; then
                    warn "$id  $token is no longer in 'secret' — the vault still has it (restorable)"
                elif [[ $(jq -r --arg n "$token" '.[] | select(.name == $n) | .changed // ""' <<<"$toks") \
                        != "$(jq -r '.meta.changed // ""' <<<"$it")" ]]; then
                    warn "$id  $token changed since it was backed up — run 'keyvault secret backup'"; stale=1
                else
                    ok "$id  matches $token in 'secret'"
                fi
                ;;
        esac
    done < <(jq -c '.items[]' "$(session_manifest)")

    local tn
    while IFS= read -r tn; do
        [[ -n $tn ]] || continue
        mf_has "$(token_id "$tn")" || { warn "$tn  a 'secret' token with no copy in the vault — run 'keyvault secret backup'"; stale=1; }
    done < <(jq -r '.[].name' <<<"$toks")

    # Anything the conf declares that never made it into the vault at all.
    if conf_load soft && (( ${#KV_SOURCES[@]} > 0 )); then
        local spec want
        for spec in "${KV_SOURCES[@]}"; do
            [[ -n $spec ]] || continue
            case "$(jq -r '.type' <<<"$spec")" in
                sparkle) want="sparkle-$(jq -r '.account' <<<"$spec")" ;;
                identities) want="$(identities_id "$spec")" ;;
                file|glob)
                    # Files are matched by where they live, not by id: a new key dropped into
                    # a globbed folder has no id until the next pack gives it one.
                    local p paths
                    if [[ $(jq -r '.type' <<<"$spec") == file ]]; then
                        p="$(untildify "$(jq -r '.path' <<<"$spec")")"
                        [[ -e $p ]] || continue          # gone: reported above as the vault's only copy
                        paths="$(resolve_path "$p")"
                    else
                        paths="$(glob_matches "$spec")"
                    fi
                    while IFS= read -r p; do
                        [[ -n $p ]] || continue
                        jq -e --arg p "$(tildify "$p")" 'any(.items[]; .path == $p)' "$(session_manifest)" >/dev/null \
                            || { warn "$(tildify "$p")  matches keyvault.conf but is not in the vault — run 'keyvault pack'"; stale=1; }
                    done <<<"$paths"
                    continue ;;
                *) continue ;;
            esac
            mf_has "$want" || { warn "$want  declared in keyvault.conf but not in the vault"; stale=1; }
        done
    fi

    say ""
    if (( rc )); then
        bad "validation failed"
    elif (( stale )); then
        warn "the vault is sound but out of date — run 'keyvault pack'"
        return 2        # distinct from 1 (broken), so a scheduled check can tell them apart
    else
        ok "the vault matches this machine"
    fi
    return $rc
}

# ---------------------------------------------------------------------------- restore

cmd_restore() {
    local apply=0 only="" force=0
    while (($#)); do
        case "$1" in
            --apply)   apply=1; shift ;;
            --dry-run) apply=0; shift ;;
            --only)    only="$2"; shift 2 ;;
            --force)   force=1; shift ;;
            *)         local n; open_opt "$@"; n=$?; (( n )) || die "restore: unknown option '$1'"; shift "$n" ;;
        esac
    done
    have jq || die "jq is not installed"
    if [[ -n $only ]]; then vault_load "$only"; else vault_load; fi

    if (( apply )); then
        step "Restoring — this WILL write to disk and to your login keychain"
    else
        step "Restoring (dry run — nothing will be changed)"
    fi

    act() { if (( apply )); then printf '  '; else printf '  %swould%s ' "$C_DIM" "$C_RESET"; fi; }

    local rc=0 it
    while IFS= read -r it; do
        local id type; id="$(jq -r '.id' <<<"$it")"; type="$(jq -r '.type' <<<"$it")"
        [[ -n $only && $only != "$id" ]] && continue
        local full; full="$(session_dir)/$(jq -r '.file' <<<"$it")"

        case "$type" in
            sparkle)
                local account; account="$(jq -r '.account' <<<"$it")"
                local sb; sb="$(kv_sparkle_bin)"
                if [[ -z $sb ]]; then
                    bad "$id  Sparkle's generate_keys not found; set KEYVAULT_SPARKLE_BIN"; rc=1; continue
                fi
                local existing; existing="$("$sb/generate_keys" -p --account "$account" 2>/dev/null)"
                if [[ -n $existing && $existing != "$(jq -r '.public_key' <<<"$it")" ]] && (( ! force )); then
                    bad "$id  keychain already holds a DIFFERENT key for '$account' ($existing) — pass --force to overwrite"
                    rc=1; continue
                fi
                say "$(act)import the ed25519 key into the login keychain as account '$account'"
                if (( apply )); then
                    "$sb/generate_keys" -f "$full" --account "$account" >/dev/null 2>&1 \
                        && ok "$id  imported" || { bad "$id  import failed"; rc=1; }
                fi
                ;;

            identities)
                local pw keychain
                pw="$(jq -r '.p12_password' <<<"$it")"
                keychain="$(jq -r '.keychain' <<<"$it")"
                [[ $keychain == /* ]] || keychain="$HOME/Library/Keychains/$keychain"
                say "$(act)import $(jq -r '.certs | length' <<<"$it") identities into $(tildify "$keychain")"
                if (( apply )); then
                    local out
                    out="$(security import "$full" -k "$keychain" -P "$pw" \
                            -T /usr/bin/codesign -T /usr/bin/security \
                            -T /usr/bin/productsign -T /usr/bin/productbuild 2>&1)"
                    if [[ $? -eq 0 ]]; then
                        ok "$id  imported"
                    elif grep -qi 'already exist' <<<"$out"; then
                        ok "$id  already present"
                    else
                        bad "$id  $out"; rc=1
                    fi
                fi
                ;;

            file)
                local path mode link
                path="$(untildify "$(jq -r '.path' <<<"$it")")"
                mode="$(jq -r '.mode // "600"' <<<"$it")"
                link="$(jq -r '.link // ""' <<<"$it")"
                [[ -n $link ]] && link="$(untildify "$link")"

                local skip=0
                if [[ -f $path ]]; then
                    if [[ "$(sha256_of "$path")" == "$(jq -r '.sha256' <<<"$it")" ]]; then
                        note "$id  $(tildify "$path") is already identical"
                        skip=1
                    elif (( ! force )); then
                        bad "$id  $(tildify "$path") exists with DIFFERENT contents — pass --force to overwrite"
                        rc=1; continue
                    fi
                fi
                if (( ! skip )); then
                    say "$(act)write $(tildify "$path") (mode $mode)"
                    if (( apply )); then
                        mkdir -p "$(dirname "$path")" \
                            && ( umask 077 && cp "$full" "$path" ) \
                            && chmod "$mode" "$path" \
                            && ok "$id  written" || { bad "$id  write failed"; rc=1; }
                    fi
                fi
                # The tool that reads this key looks for it at the link, not the real path.
                if [[ -n $link && ! -e $link ]]; then
                    say "$(act)link $(tildify "$link") -> $(tildify "$path")"
                    if (( apply )); then
                        mkdir -p "$(dirname "$link")" && ln -s "$path" "$link" \
                            && ok "$id  linked" || { bad "$id  could not create the symlink"; rc=1; }
                    fi
                fi
                ;;

            secret)
                local token; token="$(jq -r '.meta.token // ""' <<<"$it")"
                if [[ -n $token ]]; then      # a `keyvault secret` copy: back into `secret`
                    local sb ask; ask="$(jq -r '.meta.ask // "false"' <<<"$it")"
                    if ! sb="$(secret_bin)"; then
                        bad "$id  the 'secret' tool is not installed — keyvault show $id --out FILE has it"; rc=1; continue
                    fi
                    if tokens_list | jq -e --arg n "$token" 'any(.[]; .name == $n)' >/dev/null && (( ! force )); then
                        note "$id  $token is already in 'secret' — --force replaces it"; continue
                    fi
                    say "$(act)store $token with 'secret'$([[ $ask == true ]] && echo ' (--ask)')"
                    if (( apply )); then
                        # shellcheck disable=SC2046
                        "$sb" set "$token" --stdin --desc "$(jq -r '.desc // ""' <<<"$it")" $([[ $ask == true ]] && echo --ask) \
                            <"$full" >/dev/null 2>&1 && ok "$id  stored" || { bad "$id  could not store $token"; rc=1; }
                    fi
                    continue
                fi
                local path; path="$(jq -r '.path // ""' <<<"$it")"
                if [[ -n $path ]]; then
                    path="$(untildify "$path")"
                    say "$(act)write the secret to $(tildify "$path") (mode 600)"
                    if (( apply )); then
                        mkdir -p "$(dirname "$path")" && ( umask 077 && cp "$full" "$path" ) \
                            && ok "$id  written" || { bad "$id  write failed"; rc=1; }
                    fi
                else
                    note "$id  secret with no restore path — read it with: keyvault show $id --out FILE"
                fi
                ;;
        esac
    done < <(jq -c '.items[]' "$(session_manifest)")

    say ""
    if (( apply )); then
        (( rc )) && bad "restore finished with errors" || ok "restore complete"
    else
        note "nothing was changed. Re-run with --apply to do it for real."
    fi
    return $rc
}

# ---------------------------------------------------------------------------- card

# From the catalog and the public keys: printing the recovery sheet opens nothing.
cmd_card() {
    have jq || die "jq is not installed"
    local cat="$KV_CATALOG"
    [[ -f $cat ]] || cat=/dev/null
    cat <<EOF
┌──────────────────────────────────────────────────────────────────────────────┐
│  KEYVAULT RECOVERY SHEET                                                     │
│  Print this. Write the recovery key on it. Keep it where this Mac is not.   │
└──────────────────────────────────────────────────────────────────────────────┘

  Vault      $(tildify "$KV_STORE")/
  Packed     $(jq -r '.packed_at // "never"' "$cat" 2>/dev/null || echo never)

  RECOVERY KEY (write it here, by hand — it is stored nowhere else)

      AGE-SECRET-KEY-1 ______________________________________________________

      Its public half, to check you copied it right:
      $(recipient_of recovery)

  TO OPEN THE VAULT WITH NOTHING BUT age (brew install age):

      printf '%s\n' 'AGE-SECRET-KEY-1…' > r.txt          # the key above
      cd keyvault/
      for f in *.age keychain/*.age added/*.age; do
          [ -f "\$f" ] || continue
          cp "\$f" x; while grep -q 'BEGIN AGE' x; do age -d -i ../r.txt x > y && mv y x; done
          tar -xzf x; mv vault "vault-\$(basename "\$f" .age)"
      done
      rm x ../r.txt                                        # each vault-*/manifest.json lists what is where

  Or with keyvault installed:   keyvault restore --recovery

  WHAT IS INSIDE

$(jq -r '.items[]? | "      \(.id)  [\(.level // "?")]\n          \(.desc // "—")"' "$cat" 2>/dev/null)

  PUBLIC KEYS (not secret — check a restored key is the right one)

$(jq -r '.items[]? | select(.type=="sparkle") | "      \(.account)\n          \(.public_key)"' "$cat" 2>/dev/null)

  IF THE RECOVERY KEY IS LOST TOO
      Nothing here is recoverable without this Mac. Re-issue what can be re-issued
      (Apple certificates, App Store Connect keys). A lost Sparkle key cannot be:
      every installed copy of that app must be replaced by hand.
EOF
}

# ---------------------------------------------------------------------------- status / doctor

cmd_status() {
    say "${C_BOLD}keys${C_RESET}  $(tildify "$KV_KEYS")"
    if keys_ready; then
        local d
        for d in "$KV_KEYS"/biometric.*.age; do
            [[ -f $d ]] && ok "biometric  $(basename "$d" .age | sed 's/^biometric\.//')"
        done
        [[ -f $KV_KEYS/passphrase.key.age ]] && ok "passphrase"
        ok "recovery   $(recipient_of recovery)  (the key itself is on paper)"
    else
        warn "none yet — run 'keyvault setup'"
    fi
    say ""
    say "${C_BOLD}vault${C_RESET}  $(tildify "$KV_STORE")"
    if store_exists; then
        local l f a
        while IFS=$'\t' read -r l f a; do
            printf '  %-40s %-11s %s\n' "${f#"$KV_STORE"/}" "$l" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        done < <(store_files)
        local n; n="$(ls -1d "$KV_ARCHIVE"/[0-9]*/ 2>/dev/null | wc -l | tr -d ' ')"
        (( n > 0 )) && note "$n earlier version$( ((n > 1)) && echo s) in $(tildify "$KV_ARCHIVE")"
    else
        warn "nothing packed yet — run 'keyvault pack'"
    fi
    return 0
}

cmd_doctor() {
    step "Environment"
    for t in age jq shasum security openssl python3; do
        if have "$t"; then ok "$t  $(command -v "$t")"; else bad "$t  missing"; fi
    done
    if python3 -c 'import cryptography' 2>/dev/null; then
        ok "python3 cryptography  (offline ed25519 verification available)"
    else
        warn "python3 cryptography missing — 'verify' cannot derive public keys"
        note "    pip3 install cryptography"
    fi
    local sb; sb="$(kv_sparkle_bin)"
    if [[ -n $sb ]]; then ok "Sparkle tools  $(tildify "$sb")"
    else warn "Sparkle tools not found — build a Sparkle app once, or set KEYVAULT_SPARKLE_BIN"; fi

    if have age-plugin-se; then ok "age-plugin-se  (Touch ID)"
    else warn "age-plugin-se missing — Touch ID needs it: brew install age-plugin-se"; fi

    step "Keys"
    if keys_ready; then
        ok "biometric, passphrase and recovery keys in $(tildify "$KV_KEYS")"
    else
        warn "no keys yet — run 'keyvault setup'"
    fi

    step "Configuration"
    [[ -f $KV_CONF ]] && ok "config  $(tildify "$KV_CONF")" || bad "config  $(tildify "$KV_CONF") is missing"
    [[ -d $KV_DEST ]] && ok "destination  $(tildify "$KV_DEST")" \
                      || warn "destination  $(tildify "$KV_DEST") does not exist yet (pack will create it)"

    step "Sources declared in keyvault.conf"
    conf_load
    local spec
    for spec in "${KV_SOURCES[@]}"; do
        local type; type="$(jq -r '.type' <<<"$spec")"
        local lv; lv="$(jq -r '.level' <<<"$spec")"
        case "$type" in
            sparkle)
                local a p; a="$(jq -r '.account' <<<"$spec")"; p="$(untildify "$(jq -r '.plist' <<<"$spec")")"
                if [[ -n $sb ]] && [[ -n "$("$sb/generate_keys" -p --account "$a" 2>/dev/null)" ]]; then
                    ok "sparkle $a  $(dim "[$lv]")"
                else
                    bad "sparkle $a  no such key in the login keychain"
                fi
                [[ -n $p ]] && { [[ -f $p ]] && ok "  plist $(tildify "$p")" || bad "  plist $(tildify "$p") not found"; }
                ;;
            identities)
                local k n; k="$(jq -r '.keychain' <<<"$spec")"
                n="$(security find-identity -v "$k" 2>/dev/null | grep -c '^[[:space:]]*[0-9]*)')"
                [[ $n -gt 0 ]] && ok "identities $k  $n found  $(dim "[$lv]")" || bad "identities $k  none found"
                ;;
            file)
                local f r; f="$(untildify "$(jq -r '.path' <<<"$spec")")"
                r="$(resolve_path "$f")"
                if [[ -f $r ]]; then
                    [[ $r == "$f" ]] && ok "file $(tildify "$f")  $(dim "[$lv]")" \
                                     || ok "file $(tildify "$f")  $(dim "-> $(tildify "$r") [$lv]")"
                else
                    bad "file $(tildify "$f")  missing"
                fi
                ;;
            glob)
                local d pat n
                d="$(untildify "$(jq -r '.dir' <<<"$spec")")"; pat="$(jq -r '.pattern' <<<"$spec")"
                n="$(find -L "$d" -maxdepth 1 -type f -name "$pat" 2>/dev/null | wc -l | tr -d ' ')"
                [[ ${n:-0} -gt 0 ]] && ok "glob $(tildify "$d")/$pat  $n match$([[ $n -gt 1 ]] && echo es)  $(dim "[$lv]")" \
                                    || warn "glob $(tildify "$d")/$pat  no matches"
                ;;
        esac
    done
    return 0
}

# ---------------------------------------------------------------------------- catalog
#
# catalog.json sits next to the vault, unencrypted, so an agent can learn what exists
# — ids, kinds, key ids, public keys, expiry — and ask for exactly the right thing.
# It is built from an allowlist: a field the catalog does not name never leaves the vault.
# Not even sha256 goes out; for a short typed secret a hash is as good as the value.

catalog_public() {   # catalog_public <manifest> -> the allowlisted items, as a JSON array
    jq -c '[ .items[] | {
             id, type, kind: (.kind // .type), level, desc, path, link, account, public_key, plist,
             certs: (if .certs then [.certs[] | {name, kind, team_id, sha1, not_after}] else null end),
             meta: (.meta // {}), adhoc
         } | with_entries(select(.value != null and .value != "")) ]' "$1"
}

catalog_items() { jq -c '.items // []' "$KV_CATALOG" 2>/dev/null || echo '[]'; }

catalog_save() {   # catalog_save <items-json> [packed_at]
    local packed="${2:-}"
    [[ -n $packed ]] || packed="$(jq -r '.packed_at // ""' "$KV_CATALOG" 2>/dev/null)"
    mkdir -p "$KV_DEST"
    jq -n --argjson items "$1" --arg t "$(now_utc)" --arg p "$packed" --arg s "$(tildify "$KV_STORE")" \
        --arg rb "$(recipient_of biometric)" --arg rp "$(recipient_of passphrase)" --arg rr "$(recipient_of recovery)" \
        '{catalog_version: 2, generated_at: $t, packed_at: (if $p == "" then null else $p end), store: $s,
          recipients: {biometric: $rb, passphrase: $rp, recovery: $rr},
          items: ($items | sort_by(.id))}' > "$KV_CATALOG.new" \
        && mv -f "$KV_CATALOG.new" "$KV_CATALOG" \
        || warn "could not write $(tildify "$KV_CATALOG")"
}

# pack: declared items are replaced wholesale; hand-added ones, and identities pack kept
# without exporting, carry over. An added file the catalog has lost track of still gets a
# minimal entry, so list never hides it.
catalog_write_pack() {   # catalog_write_pack <manifest> <packed_at> [kept-id…]
    local declared kept f b known
    declared="$(catalog_public "$1")"
    kept="$(catalog_items | jq -c --argjson k "$(jq -nc '$ARGS.positional' --args -- "${@:3}")" \
        '[.[] | select(.adhoc or (.id as $i | any($k[]; . == $i)))]')"
    for f in "$KV_ADDED"/*.age; do
        [[ -f $f ]] || continue
        b="$(basename "$f" .age)"
        known="$(jq --arg id "${b%.*}" 'any(.[]; .id == $id)' <<<"$kept")"
        [[ $known == true ]] || kept="$(jq -c --arg id "${b%.*}" --arg l "${b##*.}" \
            '. + [{id:$id, level:$l, adhoc:true, desc:"(added by hand; details are inside the vault)"}]' <<<"$kept")"
    done
    catalog_save "$(jq -nc --argjson a "$declared" --argjson b "$kept" '$a + $b')" "$2"
}

catalog_upsert() {   # catalog_upsert <manifest> — replace entries with the same ids
    local new; new="$(catalog_public "$1")"
    catalog_save "$(catalog_items | jq -c --argjson n "$new" '[.[] | select(.id as $i | ($n | map(.id) | index($i)) | not)] + $n')"
}

catalog_drop() { catalog_save "$(catalog_items | jq -c --arg id "$1" 'map(select(.id != $id))')"; }

# ---------------------------------------------------------------------------- destination README

dest_readme_write() {
    local f="$KV_DEST/README.txt"
    cat > "$f" <<EOF
This folder holds an encrypted backup of keys that cannot be re-issued.

    keyvault/*.age          the vault, one file per level (biometric, passphrase, both)
    keyvault/keychain/*.age keychain identities, one file per keychain
    keyvault/added/*.age    items added by hand, one file each
    catalog.json            what is inside — public facts only, no secrets
    archive/                the previous $KV_ARCHIVE_KEEP versions

Every file is encrypted with age, in one or two layers. Each layer opens with this Mac's
Touch ID or passphrase key — or with the RECOVERY KEY, which is written on paper and
stored nowhere on any computer. It is safe to sync, copy and email: it is useless
without one of those.

TO OPEN IT on any machine, with the recovery key:

    brew install age
    printf '%s\n' 'AGE-SECRET-KEY-1…' > r.txt
    cd keyvault
    for f in *.age keychain/*.age added/*.age; do
        [ -f "\$f" ] || continue
        cp "\$f" x; while grep -q 'BEGIN AGE' x; do age -d -i ../r.txt x > y && mv y x; done
        tar -xzf x; mv vault "vault-\$(basename "\$f" .age)"
    done
    rm x ../r.txt

Each vault-*/manifest.json says what every file in its items/ is and where it belongs.

The tool that made this is keyvault (https://github.com/everlof/keyvault). You do not
need it to recover — the commands above are enough — but it puts everything back:

    keyvault restore --recovery            # shows what it would do
    keyvault restore --recovery --apply    # does it

Last written $(now_utc) by $(whoami)@$(hostname -s).
EOF
}

# ---------------------------------------------------------------------------- setup
#
# Creates the three keys. Every secret lives in a shell variable or a pipe until it is
# wrapped; only wrapped keys and public keys reach the disk. The recovery key is shown
# once, to be written down, and never stored.

cmd_setup() {
    local ac="any-biometry-or-passcode" force=0
    while (($#)); do
        case "$1" in
            --access-control) ac="$2"; shift 2 ;;
            --force)          force=1; shift ;;
            *) die "setup: unknown option '$1'" ;;
        esac
    done
    { exec 3</dev/tty; } 2>/dev/null || die "setup needs a human at a terminal"
    age_require
    if keys_ready && (( ! force )); then
        die "keys already exist in $(tildify "$KV_KEYS") — 'keyvault status' shows them"
    fi
    if store_exists && (( force )); then
        die "a vault already exists: new keys could not open it. Restore it, move $(tildify "$KV_STORE") aside, then run setup --force"
    fi
    if [[ -z ${KEYVAULT_SE_IDENTITY:-} ]]; then
        have age-plugin-se || die "Touch ID needs age-plugin-se — run: brew install age-plugin-se"
    fi

    local tmp="$KV_KEYS.new"
    rm -rf "$tmp"; mkdir -p "$tmp"; chmod 700 "$tmp"

    # 1. biometric: an age key, wrapped by a key that lives in the Secure Enclave.
    step "1/3  biometric key (Touch ID)"
    local se_recipient
    if [[ -n ${KEYVAULT_SE_IDENTITY:-} ]]; then          # tests: a plain key stands in for the enclave
        se_recipient="$(age-keygen -y "$KEYVAULT_SE_IDENTITY")"
    else
        age-plugin-se keygen --access-control "$ac" -o "$tmp/biometric.mac.identity" >/dev/null 2>&1 \
            || { rm -rf "$tmp"; die "could not create a Secure Enclave key (does this Mac have Touch ID?)"; }
        se_recipient="$(age-plugin-se recipients -i "$tmp/biometric.mac.identity" 2>/dev/null)"
    fi
    [[ -n $se_recipient ]] || { rm -rf "$tmp"; die "could not read the Secure Enclave key's recipient"; }
    local kb pb
    kb="$(age-keygen 2>/dev/null)"; pb="$(printf '%s\n' "$kb" | age-keygen -y -)"
    printf '%s\n' "$kb" | age --armor -r "$se_recipient" -o "$tmp/biometric.mac.age" \
        || { rm -rf "$tmp"; die "could not wrap the biometric key"; }
    kb=""
    ok "wrapped by this Mac's Secure Enclave ($ac)"

    # 2. passphrase: an age key, wrapped with your passphrase.
    step "2/3  passphrase key"
    local kp pp
    kp="$(age-keygen 2>/dev/null)"; pp="$(printf '%s\n' "$kp" | age-keygen -y -)"
    if [[ -n ${KEYVAULT_PASSPHRASE_IDENTITY:-} ]]; then  # tests: a plain key stands in for scrypt
        printf '%s\n' "$kp" | age --armor -r "$(age-keygen -y "$KEYVAULT_PASSPHRASE_IDENTITY")" -o "$tmp/passphrase.key.age"
    else
        info "  Choose the passphrase. Leave it empty and age suggests a strong one."
        printf '%s\n' "$kp" | age --armor --passphrase -o "$tmp/passphrase.key.age"
    fi || { rm -rf "$tmp"; die "could not wrap the passphrase key"; }
    kp=""
    ok "wrapped with your passphrase"

    # 3. recovery: shown once, stored nowhere.
    step "3/3  recovery key"
    local kr pr secret
    if [[ -n ${KEYVAULT_RECOVERY_IDENTITY:-} ]]; then      # tests: a known key
        kr="$(cat "$KEYVAULT_RECOVERY_IDENTITY")"
    else
        kr="$(age-keygen 2>/dev/null)"
    fi
    pr="$(printf '%s\n' "$kr" | age-keygen -y -)"
    secret="$(printf '%s\n' "$kr" | grep '^AGE-SECRET-KEY-')"
    kr=""
    cat >/dev/tty <<EOF

  ${C_BOLD}Write this down.${C_RESET} It opens the vault on any machine, without Touch ID or the
  passphrase — which is exactly why it must not live on a computer. Paper, in two places,
  or your password manager's most protected corner.

      ${C_BOLD}$(printf '%s' "$secret" | sed 's/.\{16\}/& /g')${C_RESET}

EOF
    local tail="${secret: -6}" answer
    while :; do
        printf '  Type its last 6 characters to confirm you have it: ' >/dev/tty
        IFS= read -r answer <&3 || { rm -rf "$tmp"; die "setup cancelled"; }
        answer="$(printf '%s' "$answer" | tr '[:lower:]' '[:upper:]' | tr -d ' ')"
        [[ $answer == "$tail" ]] && break
        printf '  That does not match. Look again.\n' >/dev/tty
    done
    secret=""
    printf '\033[2J\033[H' >/dev/tty 2>/dev/null     # clear the screen: it is on paper now
    ok "recovery key confirmed — it is not stored anywhere"

    printf 'biometric %s\npassphrase %s\nrecovery %s\n' "$pb" "$pp" "$pr" > "$tmp/recipients"
    chmod 600 "$tmp"/*
    if [[ -d $KV_KEYS ]]; then
        mv "$KV_KEYS" "$KV_KEYS.old.$(stamp)" || die "could not move the old keys aside"
    fi
    mv "$tmp" "$KV_KEYS" || die "could not install the keys"
    ok "keys in $(tildify "$KV_KEYS")"
    say ""
    say "Next: 'keyvault pack'. Print 'keyvault card' and keep it with the recovery key."
}

cmd_recovery_check() {
    have age-keygen || die "age is not installed"
    keys_require
    KV_RECOVERY=1
    ws_open
    factor_unlock recovery      # compares against the recorded public key, and dies if it differs
    ok "that is the right recovery key"
}

# ---------------------------------------------------------------------------- init

cmd_init() {
    [[ -f $KV_CONF ]] && die "$(tildify "$KV_CONF") already exists — 'keyvault edit' to change it"
    mkdir -p "$(dirname "$KV_CONF")"
    cp "$KV_ROOT/keyvault.conf.example" "$KV_CONF" || die "could not write $(tildify "$KV_CONF")"
    chmod 600 "$KV_CONF"
    ok "$(tildify "$KV_CONF")"
    say "Edit it ('keyvault edit'), create the keys ('keyvault setup'), check ('keyvault doctor'), then 'keyvault pack'."
}

