${C_BOLD}BUILDING AND CHECKING THE VAULT${C_RESET}
  init                        create your config from keyvault.conf.example
  pack [--fresh]              collect everything keyvault.conf declares and seal it
  list                        what is in the vault (names only, no secrets)
  validate                    does the vault still match this machine?  (exit 2: out of date)
  verify                      is the vault internally sound? (offline, no keychain)
  card                        a printable recovery sheet

${C_BOLD}CHANGING WHAT IS IN IT${C_RESET}
  add <id> --file PATH        add a file (an .p8, a licence, anything)
  add <id> --secret           add a secret typed at the prompt
  add <id> --stdin            add a secret piped in
      …  [--desc TEXT] [--restore-to PATH]
  remove <id>                 take one thing out
  show <id> --out PATH        write one item back out

${C_BOLD}PUTTING IT BACK${C_RESET}
  restore [--only ID] [--force]     dry run: says what it would do
  restore --apply                   do it

${C_BOLD}FOR AGENTS — WHAT EXISTS (no passphrase, no secrets)${C_RESET}
  catalog [--json]            every item with its public facts (key ids, public keys, expiry)
  find <text> [--json]        search ids, descriptions and metadata
  describe <id>               everything known about one item, and how to borrow it

${C_BOLD}FOR AGENTS — BORROWING (a human approves each loan)${C_RESET}
  request <id>… --reason TEXT [--ttl 30m]   ask; prints the approve command for the human
  request <id>… --reason TEXT --run -- <cmd…>
                              one-shot: the human approves this exact command, it runs once
                              during approval, keys are wiped; collect with 'result'
  result <grant>              a one-shot's output and exit status
  approve [ID] [--ttl T]      human, at a terminal: review and grant (passphrase)
  grant <id>… --reason TEXT [--ttl T]       human: request + approve in one step
  exec <grant> -- <cmd…>      run a command with \$KV_<ID> pointing at each granted file
  env <grant>                 the same paths, as export lines
  grants                      what is pending or on loan right now
  revoke <grant> | --all      end a loan early (anyone may)

${C_BOLD}THE SAFE, OPENED BY HAND${C_RESET}
  open [VAULT] / close / abort      several edits on one passphrase entry
  status                            is anything unlocked right now?
  doctor                            check tools, config and every declared source

${C_BOLD}ENVIRONMENT${C_RESET}
  KEYVAULT_DEST         where the artifact lives    (default: 'dest' in the config, else iCloud Drive/Keyvault)
  KEYVAULT_CONF         config file                 (default: ~/.config/keyvault/keyvault.conf)
  KEYVAULT_IDENTITY     age identity file — makes every command non-interactive
  KEYVAULT_SPARKLE_BIN  directory holding generate_keys and sign_update

Config lives in ${C_BOLD}$(tildify "$KV_CONF")${C_RESET} and is plain bash. See README.md.
EOF
}

# ---------------------------------------------------------------------------- dispatch

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        pack)               cmd_pack "$@" ;;
        list|ls)            cmd_list "$@" ;;
        add)                cmd_add "$@" ;;
        remove|rm)          cmd_remove "$@" ;;
        show|cat)           cmd_show "$@" ;;
        verify)             cmd_verify "$@" ;;
        validate|check)     cmd_validate "$@" ;;
        restore)            cmd_restore "$@" ;;
        card)               cmd_card "$@" ;;
        open)               session_open "${1:-$KV_ARTIFACT}" create; cmd_status ;;
        close|seal)         session_close ;;
        abort|discard)      session_abort ;;
        status)             cmd_status ;;
        doctor)             cmd_doctor "$@" ;;
        edit)               "${EDITOR:-vi}" "$KV_CONF" ;;
        init)               cmd_init ;;
        catalog|find|describe|request|approve|grant|grants|exec|env|revoke|result|_expire)
            # Agent access lives in its own file: recovery never needs it, and keeping it
            # out means a stripped-down copy of this script still restores a dead machine.
            # shellcheck source=keyvault-access.sh
            source "$KV_ROOT/keyvault-access.sh" || die "keyvault-access.sh is missing"
            access_main "$cmd" "$@" ;;
        version|--version)  say "keyvault $KV_VERSION" ;;
        help|--help|-h)     cmd_help ;;
        *)                  die "unknown command '$cmd' — try 'keyvault help'" ;;
    esac
}

# Sourcing with KEYVAULT_LIB=1 loads the functions without running a command, which is
# how tests/test_keyvault.sh reaches the internals.
[[ ${KEYVAULT_LIB:-0} == 1 ]] || main "$@"
