#!/usr/bin/env bash
#
# keyvault — an encrypted backup of every key this machine cannot re-issue.
#
# The whole tool is this one bash file on purpose. It is a *recovery* tool: the day you
# need it most is the day you are staring at a fresh Mac with no Xcode, no toolchain and
# no build step available. Everything here runs on stock macOS plus `age`.
#
# See README.md for the model. The short version:
#
#   keyvault init              create ~/.config/keyvault/keyvault.conf from the example
#   keyvault setup             create the three keys: biometric, passphrase, recovery
#   keyvault pack              collect what keyvault.conf declares -> <dest>/keyvault/
#   keyvault validate          does the vault still match this machine?
#   keyvault verify            is the vault internally sound? (offline, no keychain)
#   keyvault add / remove      put one more thing in, take one thing out
#   keyvault restore           put it all back, dry-run by default
#   keyvault catalog / find    what is in it, for agents — no passphrase (keyvault-access.sh)
#   keyvault request / approve lend specific items to an agent for a while
#
# Written to run under bash 3.2, which is what a stock macOS install ships. Homebrew
# bash is fine too, but a machine you are restoring onto will not have it.
#
set -uo pipefail

readonly KV_VERSION="2.0.0"
readonly KV_MANIFEST_VERSION=2

# ---------------------------------------------------------------------------- paths

kv_script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [[ -L $src ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
readonly KV_ROOT="$(kv_script_dir)"

# The config is yours, not the tool's: it names your keys and where they live, so it sits
# outside the repository, and the repository ships only keyvault.conf.example.
readonly KV_CONF="${KEYVAULT_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/keyvault/keyvault.conf}"
readonly KV_STATE="${KEYVAULT_STATE:-$HOME/.local/state/keyvault}"
# The keys that open the vault — or rather, the keys wrapped by what opens it: Touch ID,
# your passphrase. Useless off this machine; the recovery key covers that case.
readonly KV_KEYS="${KEYVAULT_KEYS:-$(dirname "$KV_CONF")/keys}"

readonly KV_DEST_DEFAULT="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Keyvault"

# `dest PATH` in the config says where the vault lives. The config is sourced for real
# only when a command needs the sources, so read just this one line here, in a subshell
# where every other directive is a no-op.
conf_dest() {
    [[ -f $KV_CONF ]] || return 0
    (
        sparkle() { :; }; identities() { :; }; file() { :; }; glob() { :; }; meta() { :; }; level() { :; }
        dest() { printf '%s\n' "$1" >&3; }      # fd 3: the config's own output is discarded
        # shellcheck disable=SC1090
        source "$KV_CONF" 3>&1 >/dev/null 2>&1
    ) | tail -1
}
KV_DEST="${KEYVAULT_DEST:-}"
[[ -n $KV_DEST ]] || KV_DEST="$(conf_dest)"
[[ -n $KV_DEST ]] || KV_DEST="$KV_DEST_DEFAULT"
readonly KV_DEST
readonly KV_STORE="$KV_DEST/keyvault"        # one encrypted file per level
readonly KV_KEYCHAIN="$KV_STORE/keychain"    # one per `identities` line: exported only when it changes
readonly KV_ADDED="$KV_STORE/added"          # one per item added by hand
readonly KV_CATALOG="$KV_DEST/catalog.json"
readonly KV_ARCHIVE="$KV_DEST/archive"
readonly KV_ARCHIVE_KEEP="${KEYVAULT_ARCHIVE_KEEP:-10}"

# Every item has a level: what it takes to open it.
#   biometric    Touch ID on this Mac (and, later, Face ID on a paired iPhone)
#   passphrase   the passphrase you type
#   both         both of the above
# Any level also opens with the recovery key, which lives on paper, not on this machine.
readonly KV_LEVELS="biometric passphrase both"
KV_LEVEL_DEFAULT="biometric"                 # `level` in the config changes it
KV_RECOVERY=0                                # --recovery: open with the paper key instead
# Which device unlocks the biometric factor. One key, wrapped once per device, so adding a
# device never means re-encrypting the vault.
KV_VIA="${KEYVAULT_UNLOCK_VIA:-mac}"

readonly KV_MOUNT="${KEYVAULT_MOUNT:-/Volumes/keyvault-session}"
readonly KV_RAMDISK_SECTORS="${KEYVAULT_RAMDISK_SECTORS:-262144}"   # 512-byte sectors -> 128 MB
readonly KV_NO_RAMDISK="${KEYVAULT_NO_RAMDISK:-0}"                  # tests exercise the fallback

# ---------------------------------------------------------------------------- output

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    readonly C_RESET=$'\033[0m' C_DIM=$'\033[2m' C_BOLD=$'\033[1m'
    readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m'
else
    readonly C_RESET= C_DIM= C_BOLD= C_RED= C_GREEN= C_YELLOW= C_BLUE=
fi

say()   { printf '%s\n' "$*"; }
info()  { printf '%s\n' "$*" >&2; }
step()  { printf '%s==>%s %s\n' "$C_BLUE$C_BOLD" "$C_RESET" "$*" >&2; }
ok()    { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
bad()   { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; }
warn()  { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
note()  { printf '  %s·%s %s\n' "$C_DIM" "$C_RESET" "$*"; }
dim()   { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

die() { printf '%skeyvault:%s %s\n' "$C_RED$C_BOLD" "$C_RESET" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------- utilities

have() { command -v "$1" >/dev/null 2>&1; }

sha256_of() { shasum -a 256 "$1" | awk '{print $1}'; }

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
stamp()   { date +%Y%m%d-%H%M%S; }

# Collapse a leading $HOME to "~" so a vault restores cleanly under a different username.
tildify() {
    local p="$1"
    [[ $p == "$HOME"/* ]] && printf '~%s\n' "${p#"$HOME"}" || printf '%s\n' "$p"
}
untildify() {
    local p="$1"
    [[ $p == "~"/* ]] && printf '%s\n' "$HOME${p#\~}" || printf '%s\n' "$p"
}

file_mode() { stat -f '%Lp' "$1"; }

# Resolve a symlink chain to the real file. Keys are routinely symlinked into the place a
# tool expects them from wherever they actually live (~/.appstoreconnect/private_keys is
# exactly this), and a backup that stores the link instead of the bytes is not a backup.
# BSD readlink only grew -f recently, so walk it by hand.
resolve_path() {
    local p="$1" d b t i=0
    while (( i++ < 16 )); do
        d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || break
        b="$(basename "$p")"
        [[ -L $d/$b ]] || { printf '%s/%s\n' "$d" "$b"; return 0; }
        t="$(readlink "$d/$b")"
        [[ $t == /* ]] || t="$d/$t"
        p="$t"
    done
    printf '%s\n' "$p"
}

# Bounded input: with SIGPIPE ignored by whoever started us, `tr </dev/urandom` never ends.
random_password() { head -c 1024 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 40; }

# Sparkle's own tools, wherever SPM last unpacked them. Only pack/restore need these;
# verify derives public keys itself, so a machine without Xcode can still check a vault.
kv_sparkle_bin() {
    if [[ -n ${KEYVAULT_SPARKLE_BIN:-} ]]; then
        printf '%s\n' "$KEYVAULT_SPARKLE_BIN"; return 0
    fi
    local d
    d="$(ls -dt "$HOME"/Library/Developer/Xcode/DerivedData/*/SourcePackages/artifacts/sparkle/Sparkle/bin 2>/dev/null | head -1)"
    [[ -n $d && -x $d/generate_keys ]] || return 1
    printf '%s\n' "$d"
}

# The `secret` tool beside this script, else on PATH. keyvault talks to it only through its
# commands (list --json, get, set), never to its keychain items directly.
secret_bin() {
    if [[ -n ${KEYVAULT_SECRET_BIN:-} ]]; then printf '%s\n' "$KEYVAULT_SECRET_BIN"; return 0; fi
    [[ -x $KV_ROOT/secret ]] && { printf '%s\n' "$KV_ROOT/secret"; return 0; }
    command -v secret 2>/dev/null
}

# Its tokens as [{name, ask, desc, changed}] — attributes only: listing never decrypts, so
# it never raises a dialog. [] when there is no `secret` or nothing in it.
tokens_list() {
    local sb out
    sb="$(secret_bin)" || { echo '[]'; return 0; }
    out="$("$sb" list --json 2>/dev/null)" && [[ -n $out ]] || out='[]'
    printf '%s\n' "$out"
}

# A token's copy in the vault: an added item, secret-<NAME>, sealed at `both`. Its meta
# says which token it is, whether it asks, and when the keychain item last changed, so a
# copy gone stale shows without decrypting anything.
token_id()      { printf 'secret-%s\n' "$1"; }
token_changed() { tokens_list | jq -r --arg n "$1" '.[] | select(.name == $n) | .changed // ""'; }
token_seal() {   # token_seal <name> <ask 0|1> <desc> — the value on stdin
    local changed; changed="$(token_changed "$1" </dev/null)"
    "${BASH:-bash}" "$KV_ROOT/keyvault" add "$(token_id "$1")" --stdin --level both --desc "$3" \
        --meta "token=$1" --meta "ask=$( (( $2 )) && echo true || echo false)" --meta "changed=$changed"
}

# ------------------------------------------------------------- ed25519, without a keychain
#
# Sparkle exports the private key as base64 of either the 32-byte seed or the 64-byte
# libsodium secret key (seed || public). Both forms appear in the wild, so handle both —
# and when the 64-byte form is given, cross-check that its trailing public half agrees
# with what the seed derives to. That catches a truncated or corrupted export outright.
ed25519_public_from_seed_file() {
    local f="$1"
    have python3 || return 2
    python3 - "$f" <<'PY' 2>/dev/null
import base64, sys
try:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    from cryptography.hazmat.primitives import serialization as s
except ImportError:
    sys.exit(2)
raw = base64.b64decode(open(sys.argv[1], "rb").read().strip(), validate=False)
if len(raw) not in (32, 64):
    sys.exit(3)
seed = raw[:32]
pub = Ed25519PrivateKey.from_private_bytes(seed).public_key().public_bytes(
    s.Encoding.Raw, s.PublicFormat.Raw)
if len(raw) == 64 and raw[32:] != pub:
    sys.exit(4)
print(base64.b64encode(pub).decode())
PY
}

plist_public_key() {
    local plist="$1"
    [[ -f $plist ]] || return 1
    /usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' "$plist" 2>/dev/null
}

# ---------------------------------------------------------------------------- workspace
#
# Plaintext lives on a RAM disk and nowhere else. `diskutil erasevolume` on a ram:// device
# needs no sudo, and the volume cannot survive a reboot — which is the one guarantee a
# temp directory on an SSD can never give you.

workspace_create() {   # workspace_create [mount] [sectors] [pinned]  -> "<mount>\t<device>"
    local want="${1:-$KV_MOUNT}" sectors="${2:-$KV_RAMDISK_SECTORS}" pinned="${3:-}"
    [[ -n $pinned ]] || { [[ -n ${KEYVAULT_MOUNT:-} ]] && pinned=1 || pinned=0; }
    local name dev=""
    name="$(basename "$want")"
    if (( ! KV_NO_RAMDISK )); then
        dev="$(hdiutil attach -nomount "ram://$sectors" 2>/dev/null | tr -d '[:space:]')"
    fi
    if [[ -n $dev ]] && diskutil erasevolume HFS+ "$name" "$dev" >/dev/null 2>&1; then
        chmod 700 "/Volumes/$name" 2>/dev/null
        printf '%s\t%s\n' "/Volumes/$name" "$dev"
        return 0
    fi
    [[ -n $dev ]] && hdiutil detach "$dev" >/dev/null 2>&1
    local tmp
    if (( pinned )); then
        # An explicit mount point is honoured on both paths, so a caller that pins one
        # (the test suite does) always knows where the plaintext is.
        tmp="$want"
        rm -rf "$tmp" && mkdir -p "$tmp" || die "cannot create a workspace at $tmp"
    else
        tmp="$(mktemp -d "${TMPDIR:-/tmp}/$name.XXXXXXXX")" || die "cannot create a workspace"
    fi
    chmod 700 "$tmp"
    info "${C_YELLOW}!${C_RESET} could not create a RAM disk; falling back to $tmp"
    info "  plaintext will briefly touch this disk. It is removed on close, but not overwritten."
    printf '%s\t%s\n' "$tmp" ""
}

workspace_destroy() {
    local mount="$1" dev="$2"
    if [[ -n $dev ]]; then
        hdiutil detach "$dev" >/dev/null 2>&1 || hdiutil detach "$dev" -force >/dev/null 2>&1
    elif [[ -n $mount && -d $mount ]]; then
        find "$mount" -type f -exec rm -f {} + 2>/dev/null
        rm -rf "$mount"
    fi
}

# ---------------------------------------------------------------------------- keys
#
# Three factors, three age keys:
#
#   biometric    an age key wrapped by the Secure Enclave (age-plugin-se): Touch ID
#                unwraps it. One wrap per device — keys/biometric.<device>.age — so a
#                paired iPhone (Face ID) can become one more way to unwrap the same key.
#   passphrase   an age key wrapped with your passphrase (scrypt).
#   recovery     an age key that is never stored on this machine: it lives on paper.
#
# The vault is encrypted to the public halves, so writing it (pack, add, remove) never
# asks for anything. Reading unwraps each factor it needs once per command, onto the
# RAM disk, and every layer of every file is also encrypted to the recovery key.

recipient_of() { awk -v f="$1" '$1 == f { print $2 }' "$KV_KEYS/recipients" 2>/dev/null; }
keys_ready()   { [[ -n $(recipient_of recovery) && -n $(recipient_of biometric) && -n $(recipient_of passphrase) ]]; }
keys_require() { keys_ready || die "no keys yet — run 'keyvault setup' first"; }

level_ok()     { case "$1" in biometric|passphrase|both) return 0 ;; esac; return 1; }
level_layers() {   # the factors a level is sealed with, innermost first
    case "$1" in
        biometric)  echo biometric ;;
        passphrase) echo passphrase ;;
        both)       echo "biometric passphrase" ;;
    esac
}

age_require() { have age || die "age is not installed — run: brew install age"; }

# Where a factor's unwrapped identity sits for the rest of this command.
factor_path() { printf '%s/keys/%s\n' "$WS" "$1"; }

factor_unlock() {   # factor_unlock <biometric|passphrase|recovery>
    local f="$1" out; out="$(factor_path "$1")"
    [[ -s $out ]] && return 0
    case "$f" in
        biometric)
            local wrap="$KV_KEYS/biometric.$KV_VIA.age" id="${KEYVAULT_SE_IDENTITY:-$KV_KEYS/biometric.$KV_VIA.identity}"
            [[ -f $wrap ]] || die "no biometric key for '$KV_VIA' — run 'keyvault setup'"
            [[ -n ${KEYVAULT_SE_IDENTITY:-} ]] || info "  ${C_BOLD}Touch ID${C_RESET} to unlock the biometric key ($KV_VIA)"
            ( umask 077; age -d -i "$id" -o "$out" "$wrap" ) 2>/dev/null \
                || { rm -f "$out"; die "the biometric unlock failed or was cancelled"; }
            ;;
        passphrase)
            local wrap="$KV_KEYS/passphrase.key.age"
            [[ -f $wrap ]] || die "no passphrase key — run 'keyvault setup'"
            if [[ -n ${KEYVAULT_PASSPHRASE_IDENTITY:-} ]]; then      # tests and automation only
                ( umask 077; age -d -i "$KEYVAULT_PASSPHRASE_IDENTITY" -o "$out" "$wrap" )
            else
                { : </dev/tty; } 2>/dev/null || die "the passphrase needs a human at a terminal"
                info "  ${C_BOLD}passphrase${C_RESET} to unlock the passphrase key"
                ( umask 077; age -d -o "$out" "$wrap" )
            fi || { rm -f "$out"; die "wrong passphrase, or it was cancelled"; }
            ;;
        recovery)
            if [[ -n ${KEYVAULT_RECOVERY_IDENTITY:-} ]]; then
                ( umask 077; cp "$KEYVAULT_RECOVERY_IDENTITY" "$out" ) || die "cannot read $KEYVAULT_RECOVERY_IDENTITY"
            else
                { exec 4</dev/tty; } 2>/dev/null || die "the recovery key needs a human at a terminal"
                local k
                printf 'Recovery key (AGE-SECRET-KEY-1…, not echoed): ' >/dev/tty
                IFS= read -rs k <&4; printf '\n' >/dev/tty; exec 4<&-
                # Typed from paper: forgive spaces, line breaks and lower case.
                k="$(printf '%s' "$k" | tr -d ' \t\r\n-' | tr '[:lower:]' '[:upper:]')"
                k="AGE-SECRET-KEY-${k#AGESECRETKEY}"
                [[ $k == AGE-SECRET-KEY-1* ]] || die "that is not an age secret key"
                ( umask 077; printf '%s\n' "$k" > "$out" )
            fi
            local want; want="$(recipient_of recovery)"
            if [[ -n $want && "$(age-keygen -y "$out" 2>/dev/null)" != "$want" ]]; then
                rm -f "$out"; die "that is not the recovery key this vault was made with"
            fi
            ;;
    esac
}

# seal <level> <plaintext-file> <out> — one age layer per factor, each also to recovery.
seal() {
    local level="$1" cur="$2" out="$3" f r n=0 next rec
    rec="$(recipient_of recovery)"
    for f in $(level_layers "$level"); do
        r="$(recipient_of "$f")"
        next="$WS/tmp/seal.$$.$((++n))"
        age --armor -r "$r" -r "$rec" -o "$next" "$cur" || return 1
        [[ $cur == "$2" ]] || rm -f "$cur"
        cur="$next"
    done
    mv -f "$cur" "$out"
}

# unseal <file> <level> <dir> — peel every layer with the factors (or the recovery key)
# and untar into <dir>.
unseal() {
    local src="$1" level="$2" dir="$3" cur n=0 f ids=()
    if (( KV_RECOVERY )); then
        factor_unlock recovery; ids=(-i "$(factor_path recovery)")
    else
        for f in $(level_layers "$level"); do factor_unlock "$f"; ids+=(-i "$(factor_path "$f")"); done
    fi
    cur="$src"
    while head -c 40 "$cur" | grep -q 'BEGIN AGE ENCRYPTED FILE'; do
        (( n < 4 )) || die "$(tildify "$src"): more layers than any level has"
        n=$((n + 1))
        age -d "${ids[@]}" -o "$WS/tmp/peel.$n" "$cur" 2>/dev/null \
            || die "could not decrypt $(tildify "$src") — is it this vault's, and at level $level?"
        [[ $cur == "$src" ]] || rm -f "$cur"
        cur="$WS/tmp/peel.$n"
    done
    mkdir -p "$dir"
    tar -xzf "$cur" -C "$dir" 2>/dev/null || die "$(tildify "$src") decrypted but is not a keyvault archive"
    [[ $cur == "$src" ]] || rm -f "$cur"
}

# ---------------------------------------------------------------------------- workspace
#
# Plaintext lives on a RAM disk and nowhere else. `diskutil erasevolume` on a ram:// device
# needs no sudo, and the volume cannot survive a reboot — which is the one guarantee a
