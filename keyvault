${C_BOLD}SETTING UP${C_RESET}
  init                        create your config from keyvault.conf.example
  setup                       create the keys: biometric (Touch ID), passphrase, recovery (paper)
  doctor                      check tools, keys, config and every declared source

${C_BOLD}BUILDING AND CHECKING THE VAULT${C_RESET}   levels: biometric · passphrase · both
  pack [--refresh]            collect what keyvault.conf declares and seal it (asks for nothing)
                              keychain identities are exported only when they changed; --refresh forces it
  list                        what is in the vault, from the catalog (asks for nothing)
  verify                      is the vault internally sound?
  validate                    does it still match this machine?  (exit 2: out of date)
  card                        a printable recovery sheet
  recovery-check              is the key on your paper the right one?

${C_BOLD}CHANGING WHAT IS IN IT${C_RESET}
  add <id> --file PATH | --secret | --stdin  [--level L] [--desc T] [--meta k=v] [--restore-to P]
                              recovery codes, a licence, an .p8 — anything (asks for nothing)
  remove <id>                 take an added item out
  show <id> --out PATH        write one item back out

${C_BOLD}TOKENS — the 'secret' tool, backed up${C_RESET}
  secret set NAME [--ask] [--desc T] [--stdin]   store a token, and seal a copy in the vault
  secret rm NAME              remove it, and its copy
  secret backup               copy the tokens stored with plain 'secret' (once)
  secret run NAME -- <cmd…>   run with it in the environment (list, get: as 'secret')

${C_BOLD}PUTTING IT BACK${C_RESET}
  restore [--only ID] [--force] [--apply]     dry run unless --apply

  Reading commands accept --recovery (open with the paper key: a new Mac) and
  --via DEVICE (which device unlocks the biometric key; default: mac).

${C_BOLD}FOR AGENTS — WHAT EXISTS (asks for nothing, no secrets)${C_RESET}
  catalog [--json]            every vault item and 'secret' token, with its level and public facts
  find <text> [--json]        search ids, descriptions and metadata
  describe <id>               everything known about one item, and how to borrow or use it

${C_BOLD}FOR AGENTS — BORROWING (a human approves each loan)${C_RESET}
  request <id>… --reason TEXT [--ttl 30m]   ask; prints the approve command for the human
  request <id>… --reason TEXT --run -- <cmd…>
                              one-shot: the human approves this exact command, it runs once
  result <grant>              a one-shot's output and exit status
  approve [ID] [--ttl T]      human, at a terminal: review, then unlock what the items need
  grant <id>… --reason TEXT [--ttl T]       human: request + approve in one step
  exec <grant> -- <cmd…>      run a command with \$KV_<ID> pointing at each granted file
  env <grant>                 the same paths, as export lines
  grants                      what is pending or on loan right now
  revoke <grant> | --all      end a loan early (anyone may)

  status                      keys, vault files, archive

${C_BOLD}ENVIRONMENT${C_RESET}
  KEYVAULT_DEST         where the vault lives       (default: 'dest' in the config, else iCloud Drive/Keyvault)
  KEYVAULT_CONF         config file                 (default: ~/.config/keyvault/keyvault.conf)
  KEYVAULT_KEYS         key directory               (default: next to the config, keys/)
  KEYVAULT_UNLOCK_VIA   default for --via
  KEYVAULT_SPARKLE_BIN  directory holding generate_keys and sign_update

Config lives in ${C_BOLD}$(tildify "$KV_CONF")${C_RESET} and is plain bash. See README.md.
EOF
}

# ---------------------------------------------------------------------------- dispatch

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        pack)               cmd_pack "$@" ;;
        list|ls)            cmd_list "$@" ;;
        add)                cmd_add "$@" ;;
        remove|rm)          cmd_remove "$@" ;;
        show|cat)           cmd_show "$@" ;;
        verify)             cmd_verify "$@" ;;
        validate|check)     cmd_validate "$@" ;;
        restore)            cmd_restore "$@" ;;
        card)               cmd_card "$@" ;;
        setup)              cmd_setup "$@" ;;
        recovery-check)     cmd_recovery_check "$@" ;;
        secret)             cmd_secret "$@" ;;
        open|close|abort)   die "'$cmd' is gone in 2.0: writes never ask for anything any more, so there is no session to hold open" ;;
        status)             cmd_status ;;
        doctor)             cmd_doctor "$@" ;;
        edit)               "${EDITOR:-vi}" "$KV_CONF" ;;
        init)               cmd_init ;;
        catalog|find|describe|request|approve|grant|grants|exec|env|revoke|result|_expire)
            # Agent access lives in its own file: recovery never needs it, and keeping it
            # out means a stripped-down copy of this script still restores a dead machine.
            # shellcheck source=keyvault-access.sh
            source "$KV_ROOT/keyvault-access.sh" || die "keyvault-access.sh is missing"
            access_main "$cmd" "$@" ;;
        version|--version)  say "keyvault $KV_VERSION" ;;
        help|--help|-h)     cmd_help ;;
        *)                  die "unknown command '$cmd' — try 'keyvault help'" ;;
    esac
}

# Sourcing with KEYVAULT_LIB=1 loads the functions without running a command, which is
# how tests/test_keyvault.sh reaches the internals.
[[ ${KEYVAULT_LIB:-0} == 1 ]] || main "$@"
